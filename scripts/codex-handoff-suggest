#!/usr/bin/env python3
"""Offer a handoff at Codex's automatic compaction boundary, without blocking it."""

import json
import sys


def main():
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        return
    if not isinstance(payload, dict):
        return
    if payload.get("hook_event_name") != "PreCompact" or payload.get("trigger") != "auto":
        return
    # PreCompact supports UI warnings, not model-visible additionalContext.
    # Do not return continue:false: normal compaction and session control stay intact.
    json.dump({"systemMessage": (
        "Codex is automatically compacting this conversation. For a fresh-session handoff, "
        "ask the agent to use the handoff skill to write .agent-handoff.md after compaction, "
        "then start codex new '$takeover' to continue from that note."
    )}, sys.stdout)


if __name__ == "__main__":
    main()
