#!/usr/bin/env python3
"""Bob Shell UserPromptSubmit hook: suggest a handoff once a task has spent
half of its cost limit.

Every turn resends the whole context, so a long task gets more expensive per
turn; a new task started from a handoff note continues with a small one. The
check reads the task's cost from Bob's database without using the model, and
adds one line of context, once per task, so the agent offers the handoff. Bob
stores the cost of the root task, which the hook's session_id names, in
tasks.costs (observed in Bob Shell 2.0.6). Without a cost limit, or when the
database does not look as expected, the hook adds nothing.
"""

import json
import os
from pathlib import Path
import sqlite3
import sys

SUGGESTION = (
    "This task has spent {cost:.1f} of its {limit:g} Bobcoin cost limit, and every turn resends the "
    "whole context. At the start of your reply, suggest in one line handing off to a new task. If the "
    "user accepts, write the note with the handoff skill."
)


def main():
    try:
        task_id = json.load(sys.stdin)["session_id"]
        bob = Path.home() / ".bob"
        with (bob / "settings/settings.json").open(encoding="utf-8") as stream:
            limit = json.load(stream)["session"]["maxCost"]
        database = sqlite3.connect(f"file:{bob / 'db/bob.db'}?mode=ro", uri=True)
        try:
            row = database.execute("select costs from tasks where id = ?", (task_id,)).fetchone()
        finally:
            database.close()
        cost = json.loads(row[0])["cost"]
    except (OSError, ValueError, KeyError, TypeError, sqlite3.Error):
        return
    if not isinstance(limit, (int, float)) or not isinstance(cost, (int, float)) or limit <= 0 or cost < limit / 2:
        return

    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "agent-config/bob-handoff-suggested"
    marker = state / task_id.replace("/", "_")
    if marker.exists():
        return
    state.mkdir(parents=True, exist_ok=True)
    marker.touch()
    json.dump({"hookSpecificOutput": {"hookEventName": "UserPromptSubmit",
                                      "additionalContext": SUGGESTION.format(cost=cost, limit=limit)}}, sys.stdout)


if __name__ == "__main__":
    main()
