#!/usr/bin/env bash
set -euo pipefail

command -v git >/dev/null || { echo 'git is required' >&2; exit 1; }

tmp="$(mktemp -d)"
trap 'rm -rf -- "$tmp"' EXIT

fetch() {
  git clone --quiet --depth 1 "https://github.com/$1.git" "$tmp/$2"
}

scripts_dir="$(dirname -- "${BASH_SOURCE[0]}")"
install_skill() {
  bash "$scripts_dir/install-skill" "$@"
}

fetch joshuawheelock/grill-me grill-me
fetch mattpocock/skills matt-skills
fetch obra/superpowers superpowers
fetch jgraph/drawio-mcp drawio-mcp

# These skills serve explicit requests ("grill me", a glossary or ADR), so
# they are invoked by name only: their descriptions would otherwise sit in
# every session's skill list, and Bob resends that list on every request.
bash "$scripts_dir/disable-model-invocation" "$tmp/grill-me/skills/grill-me/SKILL.md"
install_skill "$tmp/grill-me/skills/grill-me" grill-me
for name in grill-with-docs grilling domain-modeling; do
  source=''
  for group in engineering productivity; do
    [[ -d "$tmp/matt-skills/skills/$group/$name" ]] && source="$tmp/matt-skills/skills/$group/$name" && break
  done
  [[ -n "$source" ]] || { echo "Missing upstream skill: $name" >&2; exit 1; }
  bash "$scripts_dir/disable-model-invocation" "$source/SKILL.md"
  install_skill "$source" "$name"
done

# Only the draw.io skill, not its plugin: the plugin's .mcp.json adds the
# hosted MCP server, which in terminal agents only returns a link and sends
# diagram content to a third party. The Claude Code and Codex plugin copies of
# the skill are identical, so one source serves all agents.
bash "$scripts_dir/disable-model-invocation" "$tmp/drawio-mcp/plugins/claude-code/skills/drawio/SKILL.md"
install_skill "$tmp/drawio-mcp/plugins/claude-code/skills/drawio" drawio

# Every agent gets the Superpowers skills as standalone skills, without the
# Claude plugin's SessionStart hook, which injects using-superpowers into every
# session. using-superpowers (that injected text) and diagnosing-superpowers
# (troubleshooting for the plugin) only add always-on tokens, so they are
# skipped and earlier copies removed.
# The rest get disable-model-invocation: their descriptions ("You MUST use this
# before any creative work") sit in every session's skill list and push heavy
# process over the global instructions' simplicity rules. They stay available
# by name (/brainstorming) and through autonomous-development.
meta_skills=(using-superpowers diagnosing-superpowers)
for source in "$tmp/superpowers/skills/"*; do
  [[ -f "$source/SKILL.md" ]] || continue
  [[ " ${meta_skills[*]} " == *" ${source##*/} "* ]] && continue
  bash "$scripts_dir/disable-model-invocation" "$source/SKILL.md"
  install_skill "$source" "${source##*/}"
done
for name in "${meta_skills[@]}"; do
  for stale in "$HOME/.bob/skills/$name" "$HOME/.claude/skills/$name" "$HOME/.codex/skills/$name"; do
    if [[ -f "$stale/.agent-config-managed" ]]; then
      rm -rf -- "$stale"
      printf 'Removed: %s\n' "$stale"
    fi
  done
done

# uv can download Python 3.11 without changing the system Python.
uv_bin=''
if command -v uv >/dev/null 2>&1; then
  uv_bin="$(command -v uv)"
elif [[ -x "$HOME/.local/bin/uv" ]]; then
  uv_bin="$HOME/.local/bin/uv"
elif command -v pipx >/dev/null 2>&1; then
  pipx install uv
  if command -v uv >/dev/null 2>&1; then
    uv_bin="$(command -v uv)"
  elif [[ -x "$HOME/.local/bin/uv" ]]; then
    uv_bin="$HOME/.local/bin/uv"
  fi
fi

if [[ -n "$uv_bin" ]]; then
  "$uv_bin" tool install --python 3.11 specify-cli --from git+https://github.com/github/spec-kit.git
  if command -v specify >/dev/null 2>&1; then
    specify version
  elif [[ -x "$HOME/.local/bin/specify" ]]; then
    "$HOME/.local/bin/specify" version
  else
    echo 'WARNING: Spec Kit installed but specify is not on PATH' >&2
  fi
else
  echo 'WARNING: Spec Kit skipped (requires uv or pipx)' >&2
fi
