#!/usr/bin/env python3
"""Count main-session tokens, including cache reads/writes, once per request."""
import json
import sys

requests = {}
try:
    data = json.load(sys.stdin)
    with open(data["transcript_path"], encoding="utf-8") as stream:
        for line in stream:
            if not line.endswith("\n"):  # Ignore a record still being written.
                continue
            record = json.loads(line)
            if record.get("type") != "assistant" or record.get("isSidechain"):
                continue
            message = record.get("message", {})
            usage = message.get("usage") or {}
            key = record.get("requestId") or message.get("id")
            if key:
                tokens = sum(usage.get(field, 0) or 0 for field in (
                    "input_tokens", "cache_creation_input_tokens",
                    "cache_read_input_tokens", "output_tokens"))
                # Content blocks repeat usage; streaming snapshots can grow.
                requests[key] = max(requests.get(key, 0), tokens)
    print(f"Session tokens: {sum(requests.values()):,}")
except (OSError, ValueError, KeyError, TypeError) as error:
    print(f"claude-session-status: {error}", file=sys.stderr)
    print("Session tokens: unavailable")
