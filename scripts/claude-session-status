#!/usr/bin/env python3
"""Show latest context input separately from cumulative main-session tokens."""
import json
import sys

try:
    data = json.load(sys.stdin)
except (ValueError, TypeError) as error:
    print(f"claude-session-status: {error}", file=sys.stderr)
    print("Context (last input): unavailable | Session tokens: unavailable")
    sys.exit(0)

context = "Context (last input): unavailable"
try:
    window = data.get("context_window") or {}
    usage = window.get("current_usage")
    size = window.get("context_window_size")
    if usage is not None and size is not None and size > 0:
        # Match Claude's input-only context percentage, including cached input.
        # Output and cumulative transcript usage must not inflate this value.
        used = sum(usage[field] for field in (
            "input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
        context = f"Context (last input): {used:,}/{size:,} tokens ({used / size:.0%})"
except (ValueError, KeyError, TypeError, AttributeError) as error:
    print(f"claude-session-status: {error}", file=sys.stderr)

requests = {}
try:
    with open(data["transcript_path"], encoding="utf-8") as stream:
        for line in stream:
            if not line.endswith("\n"):  # Ignore a record still being written.
                continue
            record = json.loads(line)
            if record.get("type") != "assistant" or record.get("isSidechain"):
                continue
            message = record.get("message", {})
            usage = message.get("usage") or {}
            key = record.get("requestId") or message.get("id")
            if key:
                tokens = sum(usage.get(field, 0) or 0 for field in (
                    "input_tokens", "cache_creation_input_tokens",
                    "cache_read_input_tokens", "output_tokens"))
                # Content blocks repeat usage; streaming snapshots can grow.
                requests[key] = max(requests.get(key, 0), tokens)
    session = f"Session tokens: {sum(requests.values()):,}"
except (OSError, ValueError, KeyError, TypeError, AttributeError) as error:
    print(f"claude-session-status: {error}", file=sys.stderr)
    session = "Session tokens: unavailable"

print(f"{context} | {session}")
