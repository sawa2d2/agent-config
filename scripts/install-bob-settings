#!/usr/bin/env bash
set -euo pipefail

# Add agent-config defaults to Bob Shell settings, migrating old defaults
# while preserving other user values: a warning five turns before the turn
# limit, or at 80% of an explicit cost limit, so the agent wraps up before
# Bob stops the task; file tools
# that skip ignored files such as dependencies and build output; compaction
# at about 50k tokens, which keeps each turn smaller; and unlimited task cost
# (keys observed in Bob Shell 2.0.6; Bob compacts at 90% and has no cost limit
# by default). Reads outside the workspace are always auto-approved, replacing
# any other value, so a task started by `bobtask handoff` can read the earlier
# task's transcript in $TMPDIR. Bob Shell 2.1.0 cancels every tool call outside
# the workspace unless approval.outsideWorkspaceAllowed is true (undocumented,
# shown as "Allow outside workspace tool requests" in /settings), and
# auto-approves one only when its group is in approval.allowed_permissions and
# has enableOutsideWorkspace in approval.permissionOptions (both documented at
# https://bob.ibm.com/docs/shell/configuration/approval-settings).
# The execute group is auto-approved too, but only for read-only commands in
# allowedExecutors, including the forms the rtk PreToolUse hook rewrites them
# to (`git status` becomes `rtk git status`); Bob matches whole leading words
# after that rewrite, so without them every rtk command asks for approval.
# The command security check is disabled with the top-level
# isCommandSecurityEnabled set to false, keeping a value the user set. When it
# is on, an LLM reviews every shell command and any it flags (reasons such as
# "Destructive actions" or "Hardcode Password") needs explicit approval even
# when auto-approved, which stops unattended delegated tasks. The key is
# undocumented (the docs describe only `bob run --command-security`): Bob Shell
# 2.1.0 has it in its built-in defaults as true and reads `--command-security`
# first, then this setting. Bob's checks for obfuscated command syntax and
# ignore patterns still apply.
command -v python3 >/dev/null 2>&1 || {
  echo 'python3 is required to merge Bob settings safely' >&2
  exit 1
}

python3 - <<'PY'
import json
import os
from pathlib import Path
import tempfile

settings_file = Path.home() / ".bob/settings/settings.json"
defaults = {"session": {"limitWarnings": True, "respectGitIgnore": True,
                        "compactionThresholdPercent": 19, "maxCost": 0},
            "approval": {}}
# Outside the workspace, only the read group goes through: Bob still asks
# before edits and commands there.
READ_OUTSIDE_WORKSPACE = {"groupId": "read", "enableOutsideWorkspace": True}
# Bob Shell 2.1.0's default execute_command allowlist, used when the settings
# have no entry of their own (a list in the file replaces Bob's default).
BOB_APPROVED_COMMANDS = ["cat", "git diff", "git log", "git rev-parse", "git show",
                         "git status", "grep", "head", "tail", "ls", "sort", "wc",
                         "which", "du", "df"]
# What rtk 0.50.0 rewrites those commands to. Not plain `rtk`: `rtk run` and
# `rtk proxy` run any command.
RTK_APPROVED_COMMANDS = ["rtk read", "rtk git diff", "rtk git log", "rtk git show",
                         "rtk git status", "rtk grep", "rtk ls", "rtk wc", "rtk du",
                         "rtk df"]
# Earlier installs raised maxTurns to 300. A long task resends a growing
# context on every turn, and the handoff note lets a new task continue, so
# that value goes back to Bob's default of 100; any other value is the user's.
OLD_MAX_TURNS = 300
# Remove the repository's earlier task cost cap; Bob uses 0 for unlimited.
OLD_MAX_COST = 20
# Bob Shell 2.0.9 reads this native session setting as percent / 100,
# with no lower clamp in the installed distribution. 19% of the observed
# premium-ide 270000-token window is 51300 (nearest whole percent to 50k).
# The window comes from the server and can differ by model.
OLD_COMPACTION_PERCENTS = (37, 80)

# Write through a symlink (settings kept in a dotfiles checkout, say) so the link survives.
settings_file = Path(os.path.realpath(settings_file))
settings = {}
if settings_file.exists():
    with settings_file.open(encoding="utf-8") as stream:
        settings = json.load(stream)
if not isinstance(settings, dict) or not all(isinstance(settings.get(section, {}), dict) for section in defaults):
    raise SystemExit(f"Expected JSON object settings: {settings_file}")

changed = False
if settings.get("session", {}).get("maxCost") == OLD_MAX_COST:
    del settings["session"]["maxCost"]
    changed = True
if settings.get("session", {}).get("maxTurns") == OLD_MAX_TURNS:
    del settings["session"]["maxTurns"]
    changed = True
if settings.get("session", {}).get("compactionThresholdPercent") in OLD_COMPACTION_PERCENTS:
    del settings["session"]["compactionThresholdPercent"]
    changed = True
if "isCommandSecurityEnabled" not in settings:
    settings["isCommandSecurityEnabled"] = False
    changed = True
for section, values in defaults.items():
    current = settings.setdefault(section, {})
    for key, value in values.items():
        if key not in current:
            current[key] = value
            changed = True
approval = settings["approval"]
if approval.get("outsideWorkspaceAllowed") is not True:
    approval["outsideWorkspaceAllowed"] = True
    changed = True
# Without the key Bob auto-approves only the read group.
allowed = approval.setdefault("allowed_permissions", ["read"])
if not isinstance(allowed, list):
    raise SystemExit(f"Expected a list in approval.allowed_permissions: {settings_file}")
for group in ("read", "execute"):
    if group not in allowed:
        allowed.append(group)
        changed = True
executors = approval.setdefault("allowedExecutors", [])
if not isinstance(executors, list):
    raise SystemExit(f"Expected a list in approval.allowedExecutors: {settings_file}")
executor = next((entry for entry in executors
                 if isinstance(entry, dict) and entry.get("toolId") == "execute_command"), None)
if executor is None:
    executor = {"toolId": "execute_command", "approvedCommands": list(BOB_APPROVED_COMMANDS),
                "deniedCommands": []}
    executors.append(executor)
    changed = True
commands = executor.setdefault("approvedCommands", [])
if not isinstance(commands, list):
    raise SystemExit(f"Expected a list in approval.allowedExecutors approvedCommands: {settings_file}")
for command in RTK_APPROVED_COMMANDS:
    if command not in commands:
        commands.append(command)
        changed = True
options = approval.setdefault("permissionOptions", [])
if not isinstance(options, list):
    raise SystemExit(f"Expected a list in approval.permissionOptions: {settings_file}")
read_options = [option for option in options if isinstance(option, dict) and option.get("groupId") == "read"]
for option in read_options:
    if option.get("enableOutsideWorkspace") is not True:
        option["enableOutsideWorkspace"] = True
        changed = True
if not read_options:
    options.append(READ_OUTSIDE_WORKSPACE)
    changed = True
if not changed:
    raise SystemExit(0)

settings_file.parent.mkdir(parents=True, exist_ok=True)
fd, temporary = tempfile.mkstemp(prefix=f".{settings_file.name}.", dir=settings_file.parent)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        json.dump(settings, stream, ensure_ascii=False, indent=2)
        stream.write("\n")
    if settings_file.exists():
        os.chmod(temporary, settings_file.stat().st_mode & 0o777)
    os.replace(temporary, settings_file)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
print(f"Updated {settings_file}")
PY
