#!/usr/bin/env bash
set -euo pipefail

# Add agent-config defaults to Bob Shell settings without overriding any value
# the user has set: a warning five turns before the turn limit, or at 80% of
# the cost limit, so the agent wraps up before Bob stops the task; file tools
# that skip ignored files such as dependencies and build output; compaction
# before the context is nearly full, which keeps each turn smaller; and a cost
# limit per task so a runaway task cannot spend a day's share of a monthly
# Bobcoin budget (keys observed in Bob Shell 2.0.6; Bob compacts at 90% and has
# no cost limit by default).
command -v python3 >/dev/null 2>&1 || {
  echo 'python3 is required to merge Bob settings safely' >&2
  exit 1
}

python3 - <<'PY'
import json
import os
from pathlib import Path
import tempfile

settings_file = Path.home() / ".bob/settings/settings.json"
defaults = {"session": {"limitWarnings": True, "respectGitIgnore": True,
                        "compactionThresholdPercent": 80, "maxCost": 20}}
# Earlier installs raised maxTurns to 300. A long task resends a growing
# context on every turn, and the handoff note lets a new task continue, so
# that value goes back to Bob's default of 100; any other value is the user's.
OLD_MAX_TURNS = 300

# Write through a symlink (settings kept in a dotfiles checkout, say) so the link survives.
settings_file = Path(os.path.realpath(settings_file))
settings = {}
if settings_file.exists():
    with settings_file.open(encoding="utf-8") as stream:
        settings = json.load(stream)
if not isinstance(settings, dict) or not isinstance(settings.get("session", {}), dict):
    raise SystemExit(f"Expected JSON object settings: {settings_file}")

changed = False
if settings.get("session", {}).get("maxTurns") == OLD_MAX_TURNS:
    del settings["session"]["maxTurns"]
    changed = True
for section, values in defaults.items():
    current = settings.setdefault(section, {})
    for key, value in values.items():
        if key not in current:
            current[key] = value
            changed = True
if not changed:
    raise SystemExit(0)

settings_file.parent.mkdir(parents=True, exist_ok=True)
fd, temporary = tempfile.mkstemp(prefix=f".{settings_file.name}.", dir=settings_file.parent)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        json.dump(settings, stream, ensure_ascii=False, indent=2)
        stream.write("\n")
    if settings_file.exists():
        os.chmod(temporary, settings_file.stat().st_mode & 0o777)
    os.replace(temporary, settings_file)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
print(f"Updated {settings_file}")
PY
