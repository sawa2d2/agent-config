#!/usr/bin/env bash
set -euo pipefail

# Register scripts/agent-tmux-status as Bob Shell, Claude Code and Codex hooks, so
# the tmux window of a running agent shows whether it works, waits or is done.
# When rtk is on PATH, also register its PreToolUse hook (for Codex, through
# scripts/codex-rtk-hook), which rewrites shell commands to rtk equivalents
# that condense their output to save tokens. For Bob, also register
# scripts/bob-handoff-suggest on UserPromptSubmit and PostToolUse, which
# suggests a handoff once a task has spent half of its cost limit or its
# context has grown large, also during tool loops. For all three, register scripts/agent-approval-marker,
# which records that the user said "approved" for gfinish.
# Codex also gets an automatic PreCompact handoff warning. Entries whose
# command runs one of these scripts (any checkout path) or the rtk hook are
# replaced; every other hook and setting is kept. Re-running changes nothing, and the rtk entries go away once rtk is no longer installed.
command -v python3 >/dev/null 2>&1 || {
  echo 'python3 is required to merge agent hooks safely' >&2
  exit 1
}

# Startup refreshes only Codex; no argument keeps the full installer behavior.
[[ $# == 0 || ( $# == 1 && $1 == --codex-only ) ]] || {
  echo 'Usage: install-agent-hooks [--codex-only]' >&2
  exit 2
}
export AGENT_HOOKS_CODEX_ONLY=${1:-}

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
rtk=0
command -v rtk >/dev/null 2>&1 && rtk=1
AGENT_TMUX_STATUS="$repo_dir/scripts/agent-tmux-status" CODEX_RTK_HOOK="$repo_dir/scripts/codex-rtk-hook" \
  BOB_HANDOFF_SUGGEST="$repo_dir/scripts/bob-handoff-suggest" \
  CODEX_HANDOFF_SUGGEST="$repo_dir/scripts/codex-handoff-suggest" \
  AGENT_APPROVAL_MARKER="$repo_dir/scripts/agent-approval-marker" RTK="$rtk" python3 - <<'PY'
import json
import os
import shlex
from pathlib import Path
import tempfile

command = shlex.quote(os.environ["AGENT_TMUX_STATUS"])
home = Path.home()
codex_home = Path(os.environ.get("CODEX_HOME") or home / ".codex")
# Event -> (matcher or None, state). Bob has no Notification or SessionEnd
# event (observed in Bob Shell 2.0.6); a new session clears the old mark.
targets = {
    codex_home / "hooks.json": {
        "UserPromptSubmit": (None, "prompt"),
        "PreToolUse": (None, "working"),
        "PostToolUse": (None, "working"),
        # No decision output: leave Codex's ordinary approval flow intact.
        "PermissionRequest": (None, "waiting"),
        "Stop": (None, "done"),
        "Interrupt": (None, "clear"),
        "SessionEnd": (None, "clear"),
    },
    home / ".bob/settings/settings.json": {
        "SessionStart": (None, "clear"),
        "UserPromptSubmit": (None, "prompt"),
        "PreToolUse": (None, "working"),
        "PostToolUse": (None, "working"),
        "Stop": (None, "done"),
    },
    home / ".claude/settings.json": {
        "UserPromptSubmit": (None, "prompt"),
        "PreToolUse": (None, "working"),
        "PostToolUse": (None, "working"),
        "Notification": ("permission_prompt", "waiting"),
        "Stop": (None, "done"),
        "SessionEnd": (None, "clear"),
    },
}


# Event -> (matcher, command). Bob sends Claude-compatible PreToolUse input
# and applies updatedInput (observed in Bob Shell 2.0.6), so both use rtk's
# Claude hook; its rewrite keeps each agent's normal command approval. Codex
# approves every rewrite, so its hook rewrites read-only commands only.
RTK_HOOK = "rtk hook claude"
rtk_targets = {
    home / ".bob/settings/settings.json": {"PreToolUse": ("^execute_command$", RTK_HOOK)},
    home / ".claude/settings.json": {"PreToolUse": ("Bash", RTK_HOOK)},
    codex_home / "hooks.json": {"PreToolUse": ("Bash", shlex.quote(os.environ["CODEX_RTK_HOOK"]))},
}


# Event -> [(matcher, command)] registered whether or not rtk is installed.
approval_marker = shlex.quote(os.environ["AGENT_APPROVAL_MARKER"])
extra_targets = {
    home / ".bob/settings/settings.json": {
        "UserPromptSubmit": [(None, shlex.quote(os.environ["BOB_HANDOFF_SUGGEST"])), (None, approval_marker)],
        # Bob shows PostToolUse context to the model but drops PreToolUse's (Bob Shell 2.0.9).
        "PostToolUse": [(None, shlex.quote(os.environ["BOB_HANDOFF_SUGGEST"]))]},
    home / ".claude/settings.json": {"UserPromptSubmit": [(None, approval_marker)]},
    codex_home / "hooks.json": {
        "UserPromptSubmit": [(None, approval_marker)],
        "PreCompact": [("auto", shlex.quote(os.environ["CODEX_HANDOFF_SUGGEST"]))]},
}


def managed_command(command):
    return (any(script in command for script in ("agent-tmux-status", "codex-rtk-hook", "bob-handoff-suggest", "codex-handoff-suggest",
                                                    "agent-approval-marker"))
            or command == RTK_HOOK)


def unmanaged_groups(groups):
    for group in groups:
        if not isinstance(group, dict):
            yield group
            continue
        handlers = group.get("hooks", [])
        kept = [hook for hook in handlers
                if not (isinstance(hook, dict) and managed_command(hook.get("command", "")))]
        if kept == handlers:
            yield group
        elif kept:
            # A matcher group can contain user handlers alongside ours.
            yield {**group, "hooks": kept}


# Leave hook files untouched while nothing changes.
for path in dict.fromkeys([*targets, *rtk_targets, *extra_targets]):
    if os.environ["AGENT_HOOKS_CODEX_ONLY"] and path != codex_home / "hooks.json":
        continue
    events = targets.get(path, {})
    # Write through a symlink (settings kept in a dotfiles checkout, say) so the link survives.
    target = Path(os.path.realpath(path))
    settings = {}
    if target.exists():
        with target.open(encoding="utf-8") as stream:
            settings = json.load(stream)
    hooks = settings.get("hooks", {}) if isinstance(settings, dict) else None
    if not isinstance(hooks, dict) or not all(isinstance(v, list) for v in hooks.values()):
        raise SystemExit(f"Expected JSON object settings with hook lists: {path}")

    updated = {event: list(unmanaged_groups(groups)) for event, groups in hooks.items()}
    entries = [(event, matcher, f"{command} {state}") for event, (matcher, state) in events.items()]
    entries += [(event, matcher, hook) for event, pairs in extra_targets.get(path, {}).items()
                for matcher, hook in pairs]
    if os.environ["RTK"] == "1":
        entries += [(event, matcher, hook) for event, (matcher, hook) in rtk_targets.get(path, {}).items()]
    for event, matcher, hook in entries:
        group = {"matcher": matcher} if matcher else {}
        group["hooks"] = [{"type": "command", "command": hook}]
        updated.setdefault(event, []).append(group)
    updated = {event: groups for event, groups in updated.items() if groups}
    if updated == hooks:
        continue

    settings["hooks"] = updated
    target.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{target.name}.", dir=target.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(settings, stream, ensure_ascii=False, indent=2)
            stream.write("\n")
        if target.exists():
            os.chmod(temporary, target.stat().st_mode & 0o777)
        os.replace(temporary, target)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    print(f"Updated hooks: {path}")
PY
