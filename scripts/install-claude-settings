#!/usr/bin/env bash
set -euo pipefail

# Merge agent-config managed Claude Code settings: theme, default renderer and
# auto-compact window, subagent model, hidden skills, and disabled claude.ai
# connectors and Artifact tools.
# Standalone palette: no dependency on the dotfiles checkout.
# Re-run after changing the global dotfiles theme.
state_file="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/theme"
variant=${AGENT_CONFIG_THEME_VARIANT:-}
if [[ -z $variant && -f $state_file ]]; then
  IFS= read -r variant < "$state_file" || true
fi
variant=${variant:-teal}

case "$variant" in
  teal) selected='#79bfc0' ;;
  violet) selected='#b1a5e5' ;;
  orange) selected='#e9b888' ;;
  blue) selected='#75b8ed' ;;
  red) selected='#ed9298' ;;
  green) selected='#82cfaa' ;;
  *) printf 'Unknown theme variant: %s\n' "$variant" >&2; exit 2 ;;
esac

command -v python3 >/dev/null 2>&1 || {
  echo 'python3 is required to merge Claude settings safely' >&2
  exit 1
}

CLAUDE_SELECTED_COLOR="$selected" python3 - <<'PY'
import colorsys
import json
import os
from pathlib import Path
import tempfile

home = Path.home()
theme_file = home / ".claude/themes/agent-config-selected.json"
settings_file = home / ".claude/settings.json"
name = "Agent Config (Selected)"

# Claude Code uses the global body-text color for user messages.
# Keep the selected hue with consistent muted saturation and brightness.
# Reference: the previously observed violet #5f5f87 (HSV value ~0.53).
selected = os.environ["CLAUDE_SELECTED_COLOR"]
rgb = [int(selected[i:i + 2], 16) / 255 for i in (1, 3, 5)]
hue, _, _ = colorsys.rgb_to_hsv(*rgb)
dark = colorsys.hsv_to_rgb(hue, 0.38, 0.53)
background = "#" + "".join(f"{round(channel * 255):02x}" for channel in dark)

def read_json(path):
    if not path.exists():
        return {}
    with path.open(encoding="utf-8") as stream:
        result = json.load(stream)
    if not isinstance(result, dict):
        raise ValueError(f"Expected JSON object: {path}")
    return result

def write_json(path, data):
    # Write through a symlink (settings kept in a dotfiles checkout, say) so the link survives.
    path = Path(os.path.realpath(path))
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(data, stream, ensure_ascii=False, indent=2)
            stream.write("\n")
        if path.exists():
            os.chmod(temporary, path.stat().st_mode & 0o777)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)

existing = read_json(theme_file)
if existing and existing.get("name") != name:
    raise RuntimeError(f"Refusing to replace unmanaged theme: {theme_file}")
settings = read_json(settings_file)

write_json(theme_file, {
    "name": name,
    "base": "dark",
    "overrides": {"userMessageBackground": background},
})
settings["theme"] = "custom:agent-config-selected"
# Inline rendering keeps output in terminal/tmux scrollback for copy mode.
# setdefault preserves an explicit choice such as /tui fullscreen.
settings.setdefault("tui", "default")
# Every request resends the whole context, so a 1M-context session that grows
# to several hundred thousand tokens costs that much on each turn. Compact at
# about 200k instead; setdefault keeps an explicit choice.
settings.setdefault("autoCompactWindow", 200000)
# Subagents otherwise inherit the main model (often Opus) and spend it on
# searching and reading; agents that name their own model keep it.
env = settings.setdefault("env", {})
if not isinstance(env, dict):
    raise ValueError(f"Expected a JSON object in env: {settings_file}")
env.setdefault("CLAUDE_CODE_SUBAGENT_MODEL", "sonnet")
# claude.ai connectors (such as Claude Docs) and the Artifact tools put their
# schemas and instructions in every request but go unused in the CLI. The
# documented setting turns off every claude.ai connector; an explicit false is
# kept. The deny entries are merged into an existing list.
settings.setdefault("disableClaudeAiConnectors", True)
permissions = settings.setdefault("permissions", {})
if not isinstance(permissions, dict):
    raise ValueError(f"Expected a JSON object in permissions: {settings_file}")
deny = permissions.setdefault("deny", [])
if not isinstance(deny, list):
    raise ValueError(f"Expected a JSON array in permissions.deny: {settings_file}")
for tool in ("Artifact", "ArtifactComments", "ArtifactData"):
    if tool not in deny:
        deny.append(tool)
# Office and browser skills (claude.ai sync and built-in), and the Artifact and
# Claude Docs skills left useless above, put their descriptions in every
# request but rarely apply to coding. Hide them from the model and keep /name;
# an explicit override is kept.
overrides = settings.setdefault("skillOverrides", {})
if not isinstance(overrides, dict):
    raise ValueError(f"Expected a JSON object in skillOverrides: {settings_file}")
for skill in ("docx", "pptx", "xlsx", "pdf", "google-workspace", "computer-use",
              "built-in-browser", "chrome-browser", "claude-in-chrome", "morning",
              "import-memory", "artifact-design", "artifact-diagramming",
              "artifact-capabilities", "dataviz", "anthropic-skills:docs",
              "anthropic-skills:artifact-emulator"):
    overrides.setdefault(skill, "user-invocable-only")
# The built-in plugin-authoring skill (Claude Code mods) is also rarely needed.
overrides.setdefault("plugin-authoring", "user-invocable-only")
write_json(settings_file, settings)
print(f"Claude theme: {selected} -> {background} (readable light text)")
print(f"Enabled: {settings_file}")
PY
