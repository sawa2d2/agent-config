#!/usr/bin/env python3
"""Claude Code, Bob Shell and Codex UserPromptSubmit hook: record that the user
approved finalizing the current repository.

When the whole prompt, trimmed, is exactly "approved", touch
$AGENT_APPROVAL_DIR/<sha256 of the real path of the session's git top level>.
gfinish (in the dotfiles) refuses to merge from an agent process tree without
a fresh marker, so a question such as "approve 可能？" cannot count as
approval. The agent wrappers bin/claude, bin/bob and bin/codex set AGENT_APPROVAL_DIR.
Outside a git repository, or without AGENT_APPROVAL_DIR, the hook does
nothing; it never prints or blocks the prompt.
"""

import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys


def main():
    approval_dir = os.environ.get("AGENT_APPROVAL_DIR")
    try:
        event = json.load(sys.stdin)
        prompt, cwd = event["prompt"], event["cwd"]
        if not approval_dir or not isinstance(prompt, str) or prompt.strip() != "approved":
            return
        top = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"], capture_output=True,
                             text=True, check=True).stdout.rstrip("\n")
    except (OSError, ValueError, KeyError, TypeError, subprocess.CalledProcessError):
        return
    name = hashlib.sha256(os.path.realpath(top).encode()).hexdigest()
    try:
        Path(approval_dir).mkdir(parents=True, exist_ok=True)
        (Path(approval_dir) / name).touch()
    except OSError as error:
        # gfinish then refuses to merge; say why without blocking the prompt.
        print(f"agent-approval-marker: {error}", file=sys.stderr)


if __name__ == "__main__":
    main()
