#!/usr/bin/env bash
set -euo pipefail

# Supported by Codex 0.160.0 (app-server ConfigReadResponse schema).
# https://learn.chatgpt.com/docs/config-file/config-reference
# Match Claude's repository default of 200k tokens, not Bob's percentage.
python3 - <<'PY'
import os
from pathlib import Path
import re
import tempfile

config = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex") / "config.toml"
text = config.read_text(encoding="utf-8") if config.exists() else ""
# Conservatively keep explicit settings anywhere, including profiles and quoted
# or dotted keys. Python 3.9 has no TOML parser; avoid rewriting existing TOML.
key = r'''(?:model_auto_compact_token_limit|"model_auto_compact_token_limit"|'model_auto_compact_token_limit')'''
if re.search(r"(?m)^\s*(?:[^#\n=]+\.\s*)?" + key + r"\s*=", text):
    print(f"Kept existing Codex compaction setting in {config}")
else:
    # Root keys must precede all tables. Preserve the rest byte for byte.
    data = b"model_auto_compact_token_limit = 200000\n" + (config.read_bytes() if config.exists() else b"")
    target = Path(os.path.realpath(config))
    target.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{target.name}.", dir=target.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(data)
        if target.exists():
            os.chmod(temporary, target.stat().st_mode & 0o777)
        os.replace(temporary, target)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    print(f"Enabled Codex compaction threshold: 200000 tokens in {config}")
PY
