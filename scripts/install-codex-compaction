#!/usr/bin/env bash
set -euo pipefail

# Supported by Codex 0.160.0 (app-server ConfigReadResponse schema).
# https://learn.chatgpt.com/docs/config-file/config-reference
# Compact at 100k tokens, about where Claude's autoCompactWindow of 120000
# compacts. The earlier managed root line with 200000 cannot be told apart from
# a chosen value, so it moves to the new one.
python3 - <<'PY'
import os
from pathlib import Path
import re
import tempfile

config = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex") / "config.toml"
text = config.read_text(encoding="utf-8") if config.exists() else ""
# Conservatively keep explicit settings anywhere, including profiles and quoted
# or dotted keys. Python 3.9 has no TOML parser; avoid rewriting existing TOML.
key = r'''(?:model_auto_compact_token_limit|"model_auto_compact_token_limit"|'model_auto_compact_token_limit')'''
line = b"model_auto_compact_token_limit = 100000\n"
old_line = b"model_auto_compact_token_limit = 200000\n"
if text.startswith(old_line.decode()):
    data = line + config.read_bytes()[len(old_line):]
elif re.search(r"(?m)^\s*(?:[^#\n=]+\.\s*)?" + key + r"\s*=", text):
    print(f"Kept existing Codex compaction setting in {config}")
    raise SystemExit(0)
else:
    # Root keys must precede all tables. Preserve the rest byte for byte.
    data = line + (config.read_bytes() if config.exists() else b"")
target = Path(os.path.realpath(config))
target.parent.mkdir(parents=True, exist_ok=True)
fd, temporary = tempfile.mkstemp(prefix=f".{target.name}.", dir=target.parent)
try:
    with os.fdopen(fd, "wb") as stream:
        stream.write(data)
    if target.exists():
        os.chmod(temporary, target.stat().st_mode & 0o777)
    os.replace(temporary, target)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
print(f"Set Codex compaction threshold: 100000 tokens in {config}")
PY
