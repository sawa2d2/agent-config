#!/usr/bin/env bash
set -euo pipefail

# Install Claude Code plugins from the official marketplace at user scope.
# Plugins already listed by `claude plugin list` are left as they are.
plugins=(superpowers ralph-loop pyright-lsp)

if ! command -v claude >/dev/null 2>&1; then
  printf 'WARNING: Claude CLI not found; plugins not installed: %s\n' "${plugins[*]}" >&2
  exit 0
fi

if ! claude plugin marketplace list | grep -Fq "claude-plugins-official"; then
  claude plugin marketplace add anthropics/claude-plugins-official
fi
installed=$(claude plugin list)
for plugin in "${plugins[@]}"; do
  if grep -Fq "$plugin@claude-plugins-official" <<< "$installed"; then
    printf 'Already installed: %s\n' "$plugin"
  else
    claude plugin install "$plugin@claude-plugins-official" --scope user
  fi
done

# pyright-lsp needs the language server on PATH (install-nix-tools adds it with Nix).
command -v pyright-langserver >/dev/null 2>&1 ||
  echo 'WARNING: pyright-langserver not found; pyright-lsp stays inactive until pyright is installed' >&2
