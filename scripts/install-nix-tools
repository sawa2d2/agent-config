#!/usr/bin/env bash
set -euo pipefail

# AI-specific packages belong to agent-config, not dotfiles.
if ! command -v nix >/dev/null 2>&1; then
  printf '%s\n' 'WARNING: Nix not installed; skipping AI Nix packages.' >&2
  exit 0
fi

if command -v claude-agent-acp >/dev/null 2>&1; then
  printf '%s\n' 'Already available: claude-agent-acp'
  exit 0
fi

# Does not depend on a dotfiles flake, Home Manager, or sibling checkout.
nix profile install 'nixpkgs#claude-agent-acp'
