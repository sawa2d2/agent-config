#!/usr/bin/env bash
set -euo pipefail

# Manage the ACP adapter through Nix, regardless of other binaries on PATH.
if ! command -v nix >/dev/null 2>&1; then
  printf '%s\n' 'WARNING: Nix not installed; skipping AI Nix packages.' >&2
  exit 0
fi

if nix profile list | grep -Fq 'claude-agent-acp'; then
  printf '%s\n' 'Already managed by Nix: claude-agent-acp'
  exit 0
fi

NIXPKGS_ALLOW_UNFREE=1 nix profile add --impure 'nixpkgs#claude-agent-acp'
