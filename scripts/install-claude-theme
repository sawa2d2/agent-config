#!/usr/bin/env bash
set -euo pipefail

# Standalone palette: no dependency on the dotfiles checkout.
# Re-run after changing the global dotfiles theme.
state_file="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/theme"
variant=${AGENT_CONFIG_THEME_VARIANT:-}
if [[ -z $variant && -f $state_file ]]; then
  IFS= read -r variant < "$state_file" || true
fi
variant=${variant:-teal}

case "$variant" in
  teal) selected='#79bfc0' ;;
  violet) selected='#b1a5e5' ;;
  orange) selected='#e9b888' ;;
  blue) selected='#75b8ed' ;;
  red) selected='#ed9298' ;;
  green) selected='#82cfaa' ;;
  *) printf 'Unknown theme variant: %s\n' "$variant" >&2; exit 2 ;;
esac

command -v python3 >/dev/null 2>&1 || {
  echo 'python3 is required to merge Claude settings safely' >&2
  exit 1
}

CLAUDE_SELECTED_COLOR="$selected" python3 - <<'PY'
import colorsys
import json
import os
from pathlib import Path
import tempfile

home = Path.home()
theme_file = home / ".claude/themes/agent-config-selected.json"
settings_file = home / ".claude/settings.json"
name = "Agent Config (Selected)"

# Claude Code uses the global body-text color for user messages.
# Keep the selected hue with consistent muted saturation and brightness.
# Reference: the previously observed violet #5f5f87 (HSV value ~0.53).
selected = os.environ["CLAUDE_SELECTED_COLOR"]
rgb = [int(selected[i:i + 2], 16) / 255 for i in (1, 3, 5)]
hue, _, _ = colorsys.rgb_to_hsv(*rgb)
dark = colorsys.hsv_to_rgb(hue, 0.38, 0.53)
background = "#" + "".join(f"{round(channel * 255):02x}" for channel in dark)

def read_json(path):
    if path.is_symlink():
        raise RuntimeError(f"Refusing to overwrite symlink: {path}")
    if not path.exists():
        return {}
    with path.open(encoding="utf-8") as stream:
        result = json.load(stream)
    if not isinstance(result, dict):
        raise ValueError(f"Expected JSON object: {path}")
    return result

def write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(data, stream, ensure_ascii=False, indent=2)
            stream.write("\n")
        if path.exists():
            os.chmod(temporary, path.stat().st_mode & 0o777)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)

existing = read_json(theme_file)
if existing and existing.get("name") != name:
    raise RuntimeError(f"Refusing to replace unmanaged theme: {theme_file}")
settings = read_json(settings_file)

write_json(theme_file, {
    "name": name,
    "base": "dark",
    "overrides": {"userMessageBackground": background},
})
settings["theme"] = "custom:agent-config-selected"
write_json(settings_file, settings)
print(f"Claude theme: {selected} -> {background} (readable light text)")
print(f"Enabled: {settings_file}")
PY
