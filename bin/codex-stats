#!/usr/bin/env python3
"""Weekly token usage from Codex sessions.

Reads the rollouts under ~/.codex/sessions and ~/.codex/archived_sessions
(CODEX_HOME is honored). Codex writes one token_usage_record per model response
(observed in 0.160.0), counted once by its response_id; its input_tokens include
the cached and cache-write tokens. Each rollout (subagent threads have their
own) counts as a session in the week (local time, from Monday) it started; with
--window, each response counts in the fixed-length window of its timestamp.
"""
import argparse
import json
import os
import re
import sys
from datetime import datetime, timedelta
from pathlib import Path

# Input-equivalents per token, from the OpenAI GPT-5 price ratios: cached input
# 0.1x and output 8x input; cache writes cost the input price.
WEIGHTS = {"uncached": 1.0, "cached": 0.1, "output": 8.0}
LEGEND = """\
weighted = uncached_input + 0.1*cached_input + 8*output [tokens]
weights  = OpenAI GPT-5 API price ratios to the input price, the same for every model
per req  = weighted / requests [tokens]
"""


def parse_time(value):
    dt = datetime.fromisoformat(value.replace("Z", "+00:00"))
    return dt if dt.tzinfo else dt.astimezone()


def read_session(path):
    seen = set()
    start = None
    request_times = []  # (time, weighted) per response
    totals = dict.fromkeys(["requests", "uncached", "cached", "output"], 0)
    with open(path, encoding="utf-8") as f:
        for line in f:
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue
            if start is None and record.get("timestamp"):
                start = parse_time(record["timestamp"])
            payload = record.get("payload")
            if record.get("type") != "token_usage_record" or not isinstance(payload, dict):
                continue
            key = payload.get("response_id")
            usage = payload.get("usage")
            if not usage or key in seen:
                continue
            seen.add(key)
            cached = usage.get("cached_input_tokens", 0) or 0
            response = {"uncached": (usage.get("input_tokens", 0) or 0) - cached, "cached": cached,
                        "output": usage.get("output_tokens", 0) or 0}
            totals["requests"] += 1
            for k, v in response.items():
                totals[k] += v
            request_times.append((parse_time(record["timestamp"]) if record.get("timestamp") else None,
                                  sum(response[k] * w for k, w in WEIGHTS.items())))
    if not totals["requests"] or start is None:
        return None
    return {"start": start, "requests": totals["requests"],
            "weighted": round(sum(totals[k] * w for k, w in WEIGHTS.items())), "request_times": request_times}


def ratio(previous, current):
    """This window as a percentage of the previous one; '-' without one or from zero."""
    return "-" if not previous else f"{current / previous * 100:.1f}%"


def window_spec(value):
    """argparse type: 'week' or a length such as 5h, 2d or 1w."""
    if value != "week" and not re.fullmatch(r"[1-9][0-9]*[hdw]", value):
        raise argparse.ArgumentTypeError(f"expected week or a length such as 5h, 2d, 1w: {value!r}")
    return value


class Windows:
    """Local weeks from Monday ('week'), or consecutive windows of a fixed
    length, the last ending now; `count` of them are shown (0: all)."""

    def __init__(self, spec, count):
        self.spec, self.count = spec, count
        self.weekly = spec == "week"
        now = datetime.now().astimezone()
        if self.weekly:
            self.step, self.unit, self.heading, self.width = timedelta(weeks=1), "week", "week", 12
            today = now.date()
            self.first = today - timedelta(days=today.weekday(), weeks=count - 1)
        else:
            units = {"h": "hours", "d": "days", "w": "weeks"}
            self.step = timedelta(**{units[spec[-1]]: int(spec[:-1])})
            self.unit, self.heading, self.width = "window", "start", 18
            self.end = now
            self.first = now - self.step * count

    def key(self, time):
        """The week's Monday, or the start time of the window containing `time`."""
        if self.weekly:
            day = time.astimezone().date()
            return day - timedelta(days=day.weekday())
        return self.end - self.step * ((self.end - time) // self.step + 1)

    def shown(self, key):
        return not self.count or key >= self.first

    def label(self, key):
        return f"{key.isoformat() if self.weekly else key.astimezone().strftime('%Y-%m-%d %H:%M'):<{self.width}}"

    def vs_prev(self):
        u = self.unit
        return f"vs prev  = this {u} / previous {u} * 100 [%] (-: no previous {u}, or it was 0)\n"

    def column(self, item, event="started"):
        """Legend line defining the first column and what counts in it."""
        if self.weekly:
            return f"week     = Monday (local time) of the week each {item} {event}\n"
        return (f"start    = start (local time) of each {self.spec} window, the last ending now; each\n"
                f"           request counts in the window of its timestamp, and each {item} in\n"
                f"           every window it has requests in\n")


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--window", type=window_spec, default="week",
                        help="aggregation window: week (local, from Monday) or a length such as "
                             "5h, 2d, 1w ending now (default: week)")
    parser.add_argument("-w", "--windows", "--weeks", type=int, default=10,
                        help="windows shown, including the current one (0: all; default: 10)")
    args = parser.parse_args()
    windows = Windows(args.window, args.windows)

    home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
    groups = {}
    session = 0
    for directory in ("sessions", "archived_sessions"):
        for path in sorted((home / directory).glob("**/*.jsonl")):
            row = read_session(path)
            if not row:
                continue
            session += 1
            # Weekly, whole sessions count in the week they started; otherwise each
            # response counts in the window of its timestamp.
            if windows.weekly:
                entries = [(row["start"], row["requests"], row["weighted"])]
            else:
                entries = [(time or row["start"], 1, weighted) for time, weighted in row["request_times"]]
            for time, requests, weighted in entries:
                group = groups.setdefault(windows.key(time), [set(), 0, 0])
                group[0].add(session)
                group[1] += requests
                group[2] += weighted

    sums = {key: (len(ids), requests, round(weighted), weighted / requests)
            for key, (ids, requests, weighted) in groups.items()}
    print(LEGEND + windows.vs_prev() + windows.column("session"))
    print(f"{windows.heading:<{windows.width}}{'sessions':>10}{'requests':>10}{'weighted (tok)':>16}"
          f"{'per req (tok)':>15}{'weighted vs prev':>18}{'per req vs prev':>17}")
    for key, (n, requests, weighted, per_request) in sorted(sums.items()):
        if not windows.shown(key):
            continue
        previous = sums.get(key - windows.step)
        print(f"{windows.label(key)}{n:>10}{requests:>10,}{weighted:>16,}{per_request:>15,.0f}"
              f"{ratio(previous and previous[2], weighted):>18}"
              f"{ratio(previous and previous[3], per_request):>17}")

if __name__ == "__main__":
    sys.exit(main())
