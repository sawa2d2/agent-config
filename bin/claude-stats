#!/usr/bin/env python3
"""Weekly token usage from Claude Code transcripts.

Reads ~/.claude/projects/**/*.jsonl (CLAUDE_CONFIG_DIR is honored), counts each
API request once (by requestId or message id), and prints per-week sums (or per
fixed-length window with --window), or the mean, standard deviation and median
per session split into before/after groups.
"""
import argparse
import json
import os
import re
import statistics
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

# Input-token equivalents per token, from the Anthropic price ratios:
# cache write 1.25x (5 min) or 2x (1 h), cache read 0.1x, output 5x input.
WEIGHTS = {"input": 1.0, "write_5m": 1.25, "write_1h": 2.0, "read": 0.1, "output": 5.0}
# Rows of the before/after comparison: metric, unit.
SPLIT_ROWS = [("requests", "requests"), ("input", "tokens"), ("cache_write", "tokens"),
              ("cache_read", "tokens"), ("output", "tokens"), ("weighted", "tokens"),
              ("total_per_request", "tokens")]
SPLIT_LEGEND = """\
values are per session
weighted          = input + 1.25*cache_write_5m + 2*cache_write_1h + 0.1*cache_read + 5*output
weights           = Anthropic API price ratios to the input price, the same for every model
total_per_request = (input + cache_write + cache_read + output) / requests"""
WEEKLY_LEGEND = """\
weighted = input + 1.25*cache_write_5m + 2*cache_write_1h + 0.1*cache_read + 5*output [tokens]
weights  = Anthropic API price ratios to the input price, the same for every model
per req  = weighted / requests [tokens]
read/req = cache_read / requests [tokens], roughly the context each request resends
read/wr  = cache_read / cache_write (-: no cache_write)
"""
EXAMPLES = """\
--since/--until select sessions by start time. TIME is an ISO 8601 date or
date-time; without an offset it is local time.

examples:
  claude-stats                                    last 10 weeks
  claude-stats --since 2026-10-01                 weeks from Oct 1 (local) to now
  claude-stats --since 2026-10-01 --until 2026-11-01
                                                  sessions started in October
  claude-stats --since 2026-11-03T09:00 --until 2026-11-03T18:00
                                                  sessions started 9:00-18:00 that day
  claude-stats --since 2026-10-01T00:00Z          UTC instead of local time
  claude-stats --window 5h -w 6                   last six 5-hour windows
  claude-stats --split-commit HEAD~3              per-session stats before/after a commit
  claude-stats --since 2026-10-01 --json          per-session rows as JSON
"""


def parse_time(value):
    dt = datetime.fromisoformat(value.replace("Z", "+00:00"))
    return dt if dt.tzinfo else dt.astimezone()


def commit_time(ref, repo):
    out = subprocess.run(["git", "-C", repo, "show", "-s", "--format=%cI", ref],
                         capture_output=True, text=True, check=True).stdout.strip()
    return parse_time(out)


def read_session(path):
    seen = set()
    start = None
    request_times = []  # (time, weighted, cache_write, cache_read) per request
    totals = dict.fromkeys(["requests", "input", "write_5m", "write_1h", "read", "output"], 0)
    with open(path, encoding="utf-8") as f:
        for line in f:
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue
            ts = record.get("timestamp")
            if ts and start is None:
                start = parse_time(ts)
            message = record.get("message")
            usage = message.get("usage") if isinstance(message, dict) else None
            if not usage:
                continue
            key = record.get("requestId") or message.get("id")
            if key in seen:
                continue
            seen.add(key)
            creation = usage.get("cache_creation") or {}
            write_1h = creation.get("ephemeral_1h_input_tokens", 0) or 0
            write_all = usage.get("cache_creation_input_tokens", 0) or 0
            request = {"input": usage.get("input_tokens", 0) or 0, "write_5m": write_all - write_1h,
                       "write_1h": write_1h, "read": usage.get("cache_read_input_tokens", 0) or 0,
                       "output": usage.get("output_tokens", 0) or 0}
            totals["requests"] += 1
            for k, v in request.items():
                totals[k] += v
            request_times.append((parse_time(ts) if ts else None,
                                  sum(request[k] * w for k, w in WEIGHTS.items()),
                                  write_all, request["read"]))
    if not totals["requests"] or start is None:
        return None
    t = totals
    return {
        "path": str(path),
        "start": start,
        "requests": t["requests"],
        "input": t["input"],
        "cache_write": t["write_5m"] + t["write_1h"],
        "cache_read": t["read"],
        "output": t["output"],
        "total": t["input"] + t["write_5m"] + t["write_1h"] + t["read"] + t["output"],
        "weighted": round(sum(t[k] * w for k, w in WEIGHTS.items())),
        # Roughly the context size each request resends.
        "total_per_request": round((t["input"] + t["write_5m"] + t["write_1h"] + t["read"]
                                    + t["output"]) / t["requests"]),
        "request_times": request_times,
    }


def describe(values):
    if not values:
        return None
    return {
        "mean": statistics.fmean(values),
        "stdev": statistics.stdev(values) if len(values) > 1 else 0.0,
        "median": statistics.median(values),
    }


def print_group(name, sessions):
    print(f"{name}: {len(sessions)} sessions")
    if not sessions:
        return
    print(f"  {'metric':<19}{'unit':<10}{'mean':>12}{'stdev':>12}{'median':>12}")
    for metric, unit in SPLIT_ROWS:
        s = describe([x[metric] for x in sessions])
        print(f"  {metric:<19}{unit:<10}{s['mean']:>12,.0f}{s['stdev']:>12,.0f}{s['median']:>12,.0f}")


def ratio(previous, current):
    """This window as a percentage of the previous one; '-' without one or from zero."""
    return "-" if not previous else f"{current / previous * 100:.1f}%"


def print_windows(sessions, windows):
    """Print per-window sums of the shown windows with the ratio to the window
    before. Weekly, whole sessions count in the week they started; otherwise
    each request counts in the window of its timestamp."""
    if windows.weekly:
        entries = [(s["start"], i, s["requests"], s["weighted"], s["cache_write"], s["cache_read"])
                   for i, s in enumerate(sessions)]
    else:
        entries = [(time or s["start"], i, 1, weighted, write, read)
                   for i, s in enumerate(sessions)
                   for time, weighted, write, read in s["request_times"]]
    groups = {}
    for time, session, *values in entries:
        group = groups.setdefault(windows.key(time), [set(), 0, 0, 0, 0])
        group[0].add(session)
        for i, value in enumerate(values, 1):
            group[i] += value
    sums = {key: (len(ids), requests, round(weighted), weighted / requests, read / requests,
                  f"{read / write:.1f}" if write else "-")
            for key, (ids, requests, weighted, write, read) in groups.items()}
    print(WEEKLY_LEGEND + windows.vs_prev() + windows.column("session"))
    print(f"{windows.heading:<{windows.width}}{'sessions':>10}{'requests':>10}{'weighted (tok)':>16}"
          f"{'per req (tok)':>15}{'weighted vs prev':>18}{'per req vs prev':>17}"
          f"{'read/req (tok)':>16}{'read/wr':>9}")
    for key, (n, requests, weighted, per_request, read_per_request, read_write) in sorted(sums.items()):
        if not windows.shown(key):
            continue
        previous = sums.get(key - windows.step)
        print(f"{windows.label(key)}{n:>10}{requests:>10,}{weighted:>16,}{per_request:>15,.0f}"
              f"{ratio(previous and previous[2], weighted):>18}"
              f"{ratio(previous and previous[3], per_request):>17}"
              f"{read_per_request:>16,.0f}{read_write:>9}")


def window_spec(value):
    """argparse type: 'week' or a length such as 5h, 2d or 1w."""
    if value != "week" and not re.fullmatch(r"[1-9][0-9]*[hdw]", value):
        raise argparse.ArgumentTypeError(f"expected week or a length such as 5h, 2d, 1w: {value!r}")
    return value


class Windows:
    """Local weeks from Monday ('week'), or consecutive windows of a fixed
    length, the last ending now; `count` of them are shown (0: all)."""

    def __init__(self, spec, count):
        self.spec, self.count = spec, count
        self.weekly = spec == "week"
        now = datetime.now().astimezone()
        if self.weekly:
            self.step, self.unit, self.heading, self.width = timedelta(weeks=1), "week", "week", 12
            today = now.date()
            self.first = today - timedelta(days=today.weekday(), weeks=count - 1)
        else:
            units = {"h": "hours", "d": "days", "w": "weeks"}
            self.step = timedelta(**{units[spec[-1]]: int(spec[:-1])})
            self.unit, self.heading, self.width = "window", "start", 18
            self.end = now
            self.first = now - self.step * count

    def key(self, time):
        """The week's Monday, or the start time of the window containing `time`."""
        if self.weekly:
            day = time.astimezone().date()
            return day - timedelta(days=day.weekday())
        return self.end - self.step * ((self.end - time) // self.step + 1)

    def shown(self, key):
        return not self.count or key >= self.first

    def label(self, key):
        return f"{key.isoformat() if self.weekly else key.astimezone().strftime('%Y-%m-%d %H:%M'):<{self.width}}"

    def vs_prev(self):
        u = self.unit
        return f"vs prev  = this {u} / previous {u} * 100 [%] (-: no previous {u}, or it was 0)\n"

    def column(self, item, event="started"):
        """Legend line defining the first column and what counts in it."""
        if self.weekly:
            return f"week     = Monday (local time) of the week each {item} {event}\n"
        return (f"start    = start (local time) of each {self.spec} window, the last ending now; each\n"
                f"           request counts in the window of its timestamp, and each {item} in\n"
                f"           every window it has requests in\n")


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0], epilog=EXAMPLES,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--since", metavar="TIME",
                        help="only sessions starting at or after this ISO time")
    parser.add_argument("--until", metavar="TIME",
                        help="only sessions starting before this ISO time")
    split = parser.add_mutually_exclusive_group()
    split.add_argument("--split", help="ISO time dividing sessions into before/after")
    split.add_argument("--split-commit", metavar="REF",
                       help="split at the committer time of this git commit")
    parser.add_argument("--repo", default=".", help="repository for --split-commit (default: .)")
    parser.add_argument("--project", help="only transcript directories containing this substring")
    parser.add_argument("--min-requests", type=int, default=1,
                        help="skip sessions with fewer API requests (default: 1)")
    parser.add_argument("--window", type=window_spec, default="week",
                        help="aggregation window: week (local, from Monday) or a length such as "
                             "5h, 2d, 1w ending now (default: week)")
    parser.add_argument("-w", "--windows", "--weeks", type=int,
                        help="windows shown without a split, including the current one "
                             "(0: all; default: 10, or 0 with --since/--until)")
    parser.add_argument("--json", action="store_true", help="print per-session rows as JSON")
    args = parser.parse_args()

    root = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude")) / "projects"
    sessions = []
    for path in sorted(root.glob("**/*.jsonl")):
        if args.project and args.project not in str(path.parent):
            continue
        row = read_session(path)
        if row and row["requests"] >= args.min_requests:
            sessions.append(row)
    if args.since:
        sessions = [s for s in sessions if s["start"] >= parse_time(args.since)]
    if args.until:
        sessions = [s for s in sessions if s["start"] < parse_time(args.until)]
    sessions.sort(key=lambda s: s["start"])

    if args.json:
        for s in sessions:
            row = {k: v for k, v in s.items() if k != "request_times"}
            print(json.dumps({**row, "start": s["start"].isoformat()}))
        return

    if args.split:
        cut = parse_time(args.split)
    elif args.split_commit:
        cut = commit_time(args.split_commit, args.repo)
    else:
        # --since/--until already bound the range, so do not also cut it to the last 10.
        count = args.windows if args.windows is not None else 0 if args.since or args.until else 10
        print_windows(sessions, Windows(args.window, count))
        return
    print(f"split at {cut.isoformat()}")
    print(SPLIT_LEGEND)
    print_group("before", [s for s in sessions if s["start"] < cut])
    print_group("after", [s for s in sessions if s["start"] >= cut])


if __name__ == "__main__":
    sys.exit(main())
