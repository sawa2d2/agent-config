#!/usr/bin/env python3
"""Launch Codex workers and inspect repository-scoped, explicitly reported results."""

import argparse
from contextlib import contextmanager
from datetime import datetime, timezone
import fcntl
import json
import os
from pathlib import Path
import re
import select
import shutil
import subprocess
import sys
import tempfile
import time
import uuid

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from delegate_startup import launcher, pane_alive, submit, wait_for


def run(*args, cwd=None):
    return subprocess.check_output(args, cwd=cwd, stderr=subprocess.PIPE, text=True,
                                   timeout=5 if args[0] == "tmux" else None).rstrip("\n")


def git(*args, cwd=None):
    return run("git", *args, cwd=cwd)


def repository():
    # Same original-root validation as agent-backlog; never guess a local fallback.
    common = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir")).resolve()
    records = subprocess.check_output(["git", "worktree", "list", "--porcelain", "-z"]).split(b"\0\0")
    fields = records[0].split(b"\0")
    if b"bare" in fields:
        raise ValueError("a bare repository has no original working-tree root")
    root = Path(os.fsdecode(fields[0].removeprefix(b"worktree ")))
    if not root.is_dir():
        raise ValueError(f"original working tree is unavailable: {root}")
    top = Path(git("rev-parse", "--show-toplevel", cwd=root)).resolve()
    actual = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=root)).resolve()
    if actual != common or top != root.resolve():
        raise ValueError("Git metadata does not identify the original checkout; refusing to guess its root")
    worktrees = [Path(os.fsdecode(r.split(b"\0")[0][9:])) for r in records if r]
    return root, common, worktrees


def now():
    return datetime.now(timezone.utc).isoformat()


def no_symlink(path):
    if path.is_symlink():
        raise ValueError(f"refusing symlink: {path}")


def read(path):
    no_symlink(path.parent)
    no_symlink(path)
    return json.loads(path.read_text())


def replace(path, data):
    no_symlink(path)
    fd, temporary = tempfile.mkstemp(prefix=".task-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(data, stream, ensure_ascii=False, indent=2)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


@contextmanager
def writing(root, common, worktrees):
    lock_path = common / "codex-delegate.lock"
    no_symlink(lock_path)
    with lock_path.open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = root / ".codex-tasks"
        no_symlink(state)
        # Unavailable stale worktree entries cannot contain newly tracked files.
        for worktree in worktrees:
            if worktree.is_dir() and git("ls-files", "--", ".codex-tasks", cwd=worktree):
                raise ValueError(f".codex-tasks is tracked in {worktree}; resolve explicitly before writing")
        exclude = common / "info" / "exclude"
        no_symlink(exclude)
        data = exclude.read_bytes() if exclude.exists() else b""
        if data.splitlines()[-1:] != [b"/.codex-tasks/"]:
            exclude.parent.mkdir(exist_ok=True)
            with exclude.open("ab") as stream:
                stream.write((b"\n" if data and not data.endswith(b"\n") else b"") + b"/.codex-tasks/\n")
        state.mkdir(mode=0o700, exist_ok=True)
        yield state


def update(context, task_id, **fields):
    with writing(*context) as state:
        path = state / f"{task_id}.json"
        data = read(path)
        data.update(fields, updated_at=now())
        replace(path, data)


def observe(data, root):
    result = dict(data)
    directory = data.get("worktree")
    result["worktree_exists"] = bool(directory and Path(directory).is_dir())
    result["pane_observation"] = "unavailable"
    if data.get("pane") and shutil.which("tmux"):
        try:
            identity = run("tmux", "display-message", "-p", "-t", data["pane"],
                           "#{pid}\t#{@codex_delegate_task}\t#{pane_dead}")
            server, token, dead = identity.split("\t")
            if server != data["tmux_server"] or token != data["id"]:
                result["pane_observation"] = "identity-mismatch"
            else:
                result["pane_observation"] = "dead" if dead == "1" else "present (not proof of worker activity)"
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            result["pane_observation"] = "inaccessible"
            result["pane_observation_error"] = str(getattr(error, "stderr", None) or error).strip()
    # Read branch results from the surviving original checkout, not the worker.
    try:
        result["branch_head"] = git("rev-parse", "--verify", "refs/heads/" + data["branch"], cwd=root)
    except subprocess.CalledProcessError:
        result["branch_head"] = None
    result["reported_commits_on_branch"] = {}
    for commit in (data.get("report") or {}).get("commits", []):
        check = subprocess.run(["git", "merge-base", "--is-ancestor", commit,
                                "refs/heads/" + data["branch"]], cwd=root, capture_output=True)
        result["reported_commits_on_branch"][commit] = check.returncode == 0
    return result


def worker_prompt(prompt, task_id):
    command = f"codex-delegate --report {task_id}"
    return prompt + f"""

Delegated Codex task ID: {task_id}
Work on this assigned branch/worktree; do not delegate branch creation again.
The originating Codex agent continues coordinating. You own this task's branch
Git operations (commit and push verified changes), unless the task says otherwise.
Never commit to the default branch or merge it without the exact required approval.
Report explicitly from this worktree using these concrete commands:
  {command} running --summary 'Describe your actual first action here'
  {command} needs-input --summary 'Blocked by ...; need ...'
  {command} completed --summary 'Changes and remaining limitations ...' --checks 'Exact commands and actual outcomes ...' --commit FULL_COMMIT_SHA
  {command} failed --summary 'Failure and remaining work ...' --checks 'Checks run and failures, or why no checks ran ...'
Replace all example summaries/checks with your own concrete facts; never execute
these examples verbatim. Send the starting report first, before investigation.
Use repeated --commit for multiple commits; if no commit was needed, explain why
in the summary. Terminal reports require --checks. Report running when starting,
needs-input when blocked, and completed or failed before ending; also give the
final outcome in this tmux session. Reporting is explicit, not automatic. Delegate
test runs as instructed. Never claim unrun checks passed. For sandbox-denied
state writes to the original root/shared Git metadata, request supported
require_escalated approval for the exact authorized report command; never change
sandbox/auto-approval controls or use a local fallback. If approval is denied,
explain the missing report in the session. Pane presence does not prove progress.
"""


def trust_worktree(directory):
    # Use Codex's TOML editor to preserve unrelated settings and comments,
    # bypassing our interactive wrapper and its settings refreshers.
    wrapper = Path(launcher("codex")).resolve()
    executable = next((str(candidate) for entry in os.get_exec_path()
                       if (candidate := Path(entry or ".") / "codex").is_file()
                       and os.access(candidate, os.X_OK)
                       and candidate.resolve() != wrapper), None)
    if executable is None:
        raise ValueError("original codex CLI not found for directory trust registration")
    executable = str(Path(executable).absolute())
    home = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex").resolve()
    home.mkdir(parents=True, exist_ok=True)
    # Serialize delegates from different repositories using the same config.
    with (home / "codex-delegate-trust.lock").open("a") as lock, tempfile.TemporaryFile() as errors:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with subprocess.Popen([executable, "app-server"], cwd=home,
                              env=dict(os.environ, CODEX_HOME=str(home)),
                              stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                              stderr=errors, bufsize=0) as process:
            pending = b""
            deadline = time.monotonic() + 20

            def send(message):
                process.stdin.write((json.dumps(message) + "\n").encode())

            def response(request_id):
                nonlocal pending
                while True:
                    while b"\n" in pending:
                        line, pending = pending.split(b"\n", 1)
                        message = json.loads(line)
                        if message.get("id") == request_id:
                            if "error" in message:
                                raise ValueError(f"Codex directory trust registration: {message['error']}")
                            return message.get("result", {})
                    remaining = deadline - time.monotonic()
                    if remaining <= 0 or not select.select([process.stdout], [], [], remaining)[0]:
                        raise ValueError("timed out registering Codex directory trust")
                    chunk = os.read(process.stdout.fileno(), 65536)
                    if not chunk:
                        errors.seek(0)
                        raise ValueError("Codex directory trust writer exited: " + errors.read().decode(errors="replace"))
                    pending += chunk

            try:
                send(dict(id=1, method="initialize", params=dict(
                    clientInfo=dict(name="codex_delegate", version="1"))))
                response(1)
                send(dict(method="initialized"))
                send(dict(id=2, method="config/value/write", params=dict(
                    keyPath="projects." + json.dumps(str(Path(directory).resolve()), ensure_ascii=False) + ".trust_level",
                    value="trusted", mergeStrategy="replace")))
                result = response(2)
                if result.get("status") != "ok":
                    raise ValueError(f"Codex directory trust registration was not effective: {result}")
            finally:
                process.stdin.close()
                try:
                    process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()


def launch(args, context):
    root, common, worktrees = context
    if not os.environ.get("TMUX"):
        raise ValueError("run it inside tmux")
    for executable in ("gwt-path", "tmux"):
        if not shutil.which(executable):
            raise ValueError(f"{executable} not found")
    git("check-ref-format", "--branch", args.branch)
    note = Path(git("rev-parse", "--show-toplevel")) / ".agent-handoff.md"
    prompt = args.prompt
    if not prompt:
        if not note.is_file():
            raise ValueError("no .agent-handoff.md here; write one or pass a prompt")
        prompt = "Read .agent-handoff.md and continue the work it describes."
    task_id = uuid.uuid4().hex
    data = dict(id=task_id, branch=args.branch, prompt=prompt, worktree=None,
                session=None, pane=None, tmux_server=None, launch="starting", report=None,
                created_at=now(), updated_at=now())
    with writing(*context) as state:
        replace(state / f"{task_id}.json", data)
    print(f"codex-delegate: task {task_id}", flush=True)
    try:
        directory = run("gwt-path", "-b", args.branch)
        update(context, task_id, worktree=directory)
        trust_worktree(directory)
        if note.is_file():
            destination = Path(directory) / ".agent-handoff.md"
            if destination.exists():
                raise ValueError(f"refusing to overwrite {destination}")
            shutil.move(str(note), destination)
        session = run("tmux", "display-message", "-p", "-t", os.environ.get("TMUX_PANE", ""), "#{session_id}")
        server = run("tmux", "display-message", "-p", "-t", session, "#{pid}")
        update(context, task_id, session=session, tmux_server=server)
        pane = run("tmux", "new-window", "-d", "-t", session, "-n", args.branch,
                   "-c", directory, "-P", "-F", "#{pane_id}")
        update(context, task_id, pane=pane)
        run("tmux", "set-option", "-p", "-t", pane, "@codex_delegate_task", task_id)
        command = [launcher("codex"), "new"]
        if args.model:
            command += ["--model", args.model]
        command.append(worker_prompt(prompt, task_id))
        submit(pane, command)
        update(context, task_id, launch="sent")
        print(f"codex-delegate: launch input sent (pane {pane}); waiting up to 90s for worker report", flush=True)

        def acknowledged():
            pane_alive(pane)
            report = read(root / ".codex-tasks" / f"{task_id}.json").get("report")
            if report and report["state"] in ("failed", "needs-input"):
                raise ValueError(f"worker reported {report['state']}: {report['summary']}")
            return bool(report and report["state"] in ("running", "completed"))

        wait_for(acknowledged, 90, "the worker's explicit running/completed report")
        update(context, task_id, launch="verified")
        print(f"codex-delegate: verified worker startup in window for {args.branch} (pane {pane}) at {directory}; review --status for progress/results")
    except (OSError, ValueError, subprocess.SubprocessError, KeyboardInterrupt) as error:
        detail = str(error)
        if isinstance(error, subprocess.CalledProcessError) and error.stderr:
            detail += ": " + error.stderr.strip()
        update(context, task_id, launch="failed", launch_error=detail)
        raise ValueError(f"task {task_id}: partial launch failed: {detail}; inspect --status; retained worktree/window/handoff are not removed. No automatic retry: inspect --status and the pane before retrying to avoid duplicate agents") from error


def main():
    parser = argparse.ArgumentParser(description=__doc__, epilog="Status reads never write state. Worker reports and pane liveness are independent; verify Git results before accepting completion.")
    parser.add_argument("-m", "--model")
    parser.add_argument("--repo", metavar="PATH", help="use this repository directory instead of cwd (reports require the assigned worktree)")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--list", action="store_true", help="list stored tasks as JSON, without tmux")
    mode.add_argument("--status", metavar="ID", help="inspect stored result, Git refs and on-demand pane identity")
    mode.add_argument("--report", metavar="ID", help="worker report: ID {running,needs-input,completed,failed} --summary TEXT [--checks TEXT] [--commit SHA ...]")
    parser.add_argument("--summary")
    parser.add_argument("--checks")
    parser.add_argument("--commit", action="append", default=[])
    parser.add_argument("branch", nargs="?", help="new branch, or worker state with --report")
    parser.add_argument("prompt", nargs="?")
    # Preserve the original launch grammar, including a prompt beginning with
    # '-' that happens to resemble one of the new management options.
    argv = sys.argv[1:]
    prefix = []
    while argv:
        if argv[0] in ("-m", "--model", "--repo"):
            option = "--model" if argv[0] == "-m" else argv[0]
            if len(argv) < 2 or not argv[1]:
                parser.error(f"{option} requires a nonempty value")
            prefix.append(option + "=" + argv[1])
            argv = argv[2:]
        elif argv[0].startswith(("--model=", "--repo=")):
            prefix.append(argv[0])
            argv = argv[1:]
        else:
            if not argv[0].startswith("-"):
                argv = ["--", *argv]
            break
    args = parser.parse_args(prefix + argv)
    if args.report:
        if args.branch not in ("running", "needs-input", "completed", "failed") or not args.summary or not args.summary.strip() or args.prompt:
            parser.error("report needs a valid state and nonempty --summary")
        if args.branch in ("completed", "failed") and (not args.checks or not args.checks.strip()):
            parser.error("completed/failed reports require nonempty --checks")
    elif args.summary is not None or args.checks is not None or args.commit:
        parser.error("report fields require --report")
    if (args.list or args.status) and (args.branch or args.prompt or args.model):
        parser.error("read commands do not take launch arguments")
    if args.report and args.model:
        parser.error("--model applies only to launch")
    if not (args.list or args.status or args.report) and (not args.branch or args.branch.startswith("-")):
        parser.error("a new branch is required")
    if args.repo is not None:
        if not args.repo:
            parser.error("--repo requires a nonempty value")
        # All Git, handoff and worktree operations use the selected checkout,
        # including report identity checks. Validate before any state writes.
        os.chdir(args.repo)
    context = repository()
    root, common, worktrees = context
    state = root / ".codex-tasks"
    no_symlink(state)
    if args.list:
        print(json.dumps([read(path) for path in sorted(state.glob("*.json"))], ensure_ascii=False, indent=2))
    elif args.status or args.report:
        task_id = args.status or args.report
        if not re.fullmatch(r"[0-9a-f]{32}", task_id):
            raise ValueError("invalid task ID")
        data = read(state / f"{task_id}.json")
        if args.status:
            print(json.dumps(observe(data, root), ensure_ascii=False, indent=2))
        else:
            if not data["worktree"] or Path(git("rev-parse", "--show-toplevel")).resolve() != Path(data["worktree"]).resolve():
                raise ValueError("report must run from the assigned worker worktree")
            if git("symbolic-ref", "--short", "HEAD") != data["branch"]:
                raise ValueError("worker is no longer on its assigned branch")
            for commit in args.commit:
                if not re.fullmatch(r"[0-9a-fA-F]{40}|[0-9a-fA-F]{64}", commit):
                    raise ValueError("--commit requires a full commit SHA")
                git("cat-file", "-e", commit + "^{commit}")
            update(context, task_id, report=dict(state=args.branch, summary=args.summary,
                   checks=args.checks, commits=args.commit, reported_at=now()))
            print(f"codex-delegate: {task_id} reported {args.branch}")
    else:
        launch(args, context)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"codex-delegate: {error}", file=sys.stderr)
        if isinstance(error, subprocess.CalledProcessError) and error.stderr:
            print(error.stderr.strip(), file=sys.stderr)
        if isinstance(error, PermissionError) or isinstance(error.__cause__, PermissionError):
            print("Request supported require_escalated approval for this exact authorized operation; never weaken the sandbox or use a worktree-local fallback.", file=sys.stderr)
        sys.exit(1)
