#!/usr/bin/env bash
set -euo pipefail

for cmd in bob sqlite3 fzf; do
  command -v "$cmd" >/dev/null 2>&1 || {
    printf 'bobla: %s is required\n' "$cmd" >&2
    exit 1
  }
done

db="$HOME/.bob/db/bob.db"
[[ -f "$db" ]] || { printf 'bobla: database not found: %s\n' "$db" >&2; exit 1; }

# Internal Bob database schema (observed in Bob Shell 2.0.6): read-only access;
# never modify task records. Resumable tasks are top-level rows with a user
# message, and project_id holds the launch directory as "file:<path>[?query]"
# (directory is stored empty).
rows=$(sqlite3 -readonly -separator $'\t' "$db" "
  WITH workspaces AS (
    SELECT id, updated_at, title,
           CASE WHEN directory GLOB '/*' THEN directory
                WHEN project_id LIKE 'file:/%' THEN substr(project_id, 6)
           END AS path
    FROM tasks
    WHERE parent_id IS NULL
      AND EXISTS (SELECT 1 FROM messages WHERE messages.task_id = tasks.id AND messages.role = 'user')
  ), dirs AS (
    SELECT id, updated_at, title,
           CASE WHEN instr(path, '?') > 0 THEN substr(path, 1, instr(path, '?') - 1) ELSE path END AS directory
    FROM workspaces
    WHERE path IS NOT NULL
  )
  SELECT id,
         directory,
         datetime(
           CASE WHEN updated_at >= 100000000000 THEN updated_at / 1000
                ELSE updated_at END,
           'unixepoch', 'localtime'
         ),
         printf('%-20s', CASE
           WHEN length(directory) > 20 THEN '…' || substr(directory, -19)
           ELSE directory
         END),
         replace(replace(replace(title, char(9), ' '), char(10), ' '), char(13), ' ')
  FROM dirs
  ORDER BY updated_at DESC;
")

[[ -n "$rows" ]] || { echo 'bobla: no tasks found' >&2; exit 0; }

selected=$(printf '%s\n' "$rows" |
  fzf --delimiter=$'\t' --with-nth=3,4,5 --no-sort \
      --header='UPDATED | DIRECTORY | TITLE') || exit 0

IFS=$'\t' read -r task_id directory _ <<< "$selected"
[[ -n "$task_id" && -n "$directory" ]] || exit 1
[[ -d "$directory" ]] || { printf 'bobla: directory not found: %s\n' "$directory" >&2; exit 1; }

cd -- "$directory"
exec bob chat --resume "$task_id" --auto-approve
