#!/usr/bin/env bash
set -euo pipefail

# Resolve the underlying CLI without recursively invoking this wrapper.
repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
wrapper_dir="$repo_dir/bin"
original_path=$PATH
PATH=
IFS=: read -r -a entries <<< "$original_path"
for entry in "${entries[@]}"; do
  [[ -n "$entry" ]] || entry=.
  resolved=$(cd -- "$entry" 2>/dev/null && pwd -P || true)
  [[ "$resolved" == "$wrapper_dir" ]] && continue
  PATH="${PATH:+$PATH:}$entry"
done
export PATH

real_cli=$(command -v claude || true)
[[ -n "$real_cli" ]] || {
  echo 'claude: original Claude Code executable not found' >&2
  exit 127
}

# Preserve RGB colors inside tmux; otherwise Claude may quantize them to 256 colors.
export CLAUDE_CODE_TMUX_TRUECOLOR=1

# Leave mouse events to the terminal (text selection, tmux scrolling); an
# explicit value from the caller wins.
export CLAUDE_CODE_DISABLE_MOUSE=${CLAUDE_CODE_DISABLE_MOUSE:-1}

# Over SSH, Claude Code copies only via OSC 52, which some terminals (e.g. GNOME
# Terminal) ignore. With X11 forwarding and xclip, hide the SSH markers so it
# uses xclip, which reaches the local clipboard through DISPLAY.
if [[ $(uname -s) == Linux && -n ${DISPLAY:-} ]] && command -v xclip >/dev/null 2>&1; then
  unset SSH_CONNECTION SSH_TTY SSH_CLIENT
fi

# Refresh the managed Claude settings (theme, renderer, tmux status hooks).
bash "$repo_dir/scripts/install-claude-settings" >/dev/null
bash "$repo_dir/scripts/install-agent-hooks" >/dev/null

# Resume the latest session of this directory when no arguments are supplied.
# Claude Code keeps it under projects/<cwd with non-alphanumerics as "-">;
# without one, --continue fails, so start a new session instead.
if (( $# == 0 )); then
  project_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$(pwd -P | sed 's/[^A-Za-z0-9]/-/g')"
  if compgen -G "$project_dir/*.jsonl" >/dev/null; then
    exec "$real_cli" --continue
  fi
  exec "$real_cli"
fi
# "new" starts a new session instead of sending "new" as the first prompt.
if [[ $1 == new ]]; then
  exec "$real_cli" "${@:2}"
fi

exec "$real_cli" "$@"
