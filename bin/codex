#!/usr/bin/env bash
set -euo pipefail

# Resolve the underlying CLI without recursively invoking this wrapper.
wrapper_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
original_path=$PATH
PATH=
IFS=: read -r -a entries <<< "$original_path"
for entry in "${entries[@]}"; do
  [[ -n "$entry" ]] || entry=.
  [[ "$(cd -- "$entry" 2>/dev/null && pwd -P || true)" == "$wrapper_dir" ]] && continue
  PATH="${PATH:+$PATH:}$entry"
done
export PATH
real_cli=$(command -v codex || true)
[[ -n "$real_cli" ]] || { echo 'codex: original codex CLI not found' >&2; exit 127; }

# Refresh the selected theme accent and managed hooks before the CLI loads them.
bash "$wrapper_dir/../scripts/install-codex-theme" >/dev/null
bash "$wrapper_dir/../scripts/install-agent-hooks" >/dev/null

if (( $# == 0 )); then
  set -- resume --last
elif [[ $1 == new ]]; then
  # "new" starts a new session; Codex has no such subcommand.
  shift
fi

# Automatic review keeps the workspace-write sandbox. Explicit permission
# choices (including profiles and config overrides) must take precedence.
auto_review=true
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  arg=${args[i]}
  case $arg in
    --) break ;;
    --approve-for-me|--full-auto|--yolo|--dangerously-bypass-approvals-and-sandbox|\
    -a*|--ask-for-approval|--ask-for-approval=*|\
    -s*|--sandbox|--sandbox=*|\
    -p*|--profile|--profile=*)
      auto_review=false
      break ;;
    -c|--config)
      i=$((i + 1))
      arg=${args[i]:-} ;;
    --config=*) arg=${arg#--config=} ;;
    -c*) arg=${arg#-c} ;;
    -m|-i|-C|--model|--image|--cd|--add-dir|--enable|--disable|\
    --remote|--remote-auth-token-env|--local-provider|--output-schema|\
    --color|-o|--output-last-message|--thread-source)
      i=$((i + 1))
      continue ;;
    *) continue ;;
  esac
  if [[ $arg =~ ^[[:space:]]*(approval_policy|approvals_reviewer|sandbox_mode|sandbox_permissions|default_permissions)[[:space:]]*= ]]; then
    auto_review=false
    break
  fi
done
if $auto_review; then
  set -- --approve-for-me "$@"
fi
exec "$real_cli" "$@"
