#!/usr/bin/env bash
set -euo pipefail

# Resolve the underlying CLI without recursively invoking this wrapper.
wrapper_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
original_path=$PATH
PATH=
IFS=: read -r -a entries <<< "$original_path"
for entry in "${entries[@]}"; do
  [[ -n "$entry" ]] || entry=.
  [[ "$(cd -- "$entry" 2>/dev/null && pwd -P || true)" == "$wrapper_dir" ]] && continue
  PATH="${PATH:+$PATH:}$entry"
done
export PATH
real_cli=$(command -v codex || true)
[[ -n "$real_cli" ]] || { echo 'codex: original codex CLI not found' >&2; exit 127; }

# Mark this process tree for gfinish; only the user's exact "approved"
# prompt recorded by agent-approval-marker authorizes finalizing a repository.
export AGENT_APPROVAL_DIR=${AGENT_APPROVAL_DIR:-${XDG_RUNTIME_DIR:-$HOME/.cache}/agent-approval}

# Refresh the selected theme accent and managed hooks before the CLI loads them.
bash "$wrapper_dir/../scripts/install-codex-theme" >/dev/null
bash "$wrapper_dir/../scripts/install-codex-compaction" >/dev/null
bash "$wrapper_dir/../scripts/install-agent-hooks" --codex-only >/dev/null

automatic_handoff=false
if [[ ${1:-} == auto-handoff ]]; then
  automatic_handoff=true
  shift
fi

if (( $# == 0 )); then
  set -- resume --last
elif [[ $1 == new ]]; then
  # "new" starts a new session; Codex has no such subcommand.
  shift
fi

# Codex's worktrees feature expands resume's cwd filter to every linked
# checkout. Keep automatic resume and the picker local to this directory;
# --all still opts into other directories and explicit config can override.
if [[ ${1:-} == resume ]]; then
  set -- -c features.worktrees=false "$@"
fi

# Automatic review keeps the workspace-write sandbox. Explicit permission
# choices (including profiles and config overrides) must take precedence.
auto_review=true
no_alt_screen=true
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  arg=${args[i]}
  case $arg in
    --) break ;;
    --no-alt-screen)
      no_alt_screen=false
      continue ;;
    --approve-for-me|--full-auto|--yolo|--dangerously-bypass-approvals-and-sandbox|\
    -a*|--ask-for-approval|--ask-for-approval=*|\
    -s*|--sandbox|--sandbox=*|\
    -p*|--profile|--profile=*)
      auto_review=false
      case $arg in
        -a|--ask-for-approval|-s|--sandbox|-p|--profile) i=$((i + 1)) ;;
      esac
      continue ;;
    -c|--config)
      i=$((i + 1))
      arg=${args[i]:-} ;;
    --config=*) arg=${arg#--config=} ;;
    -c*) arg=${arg#-c} ;;
    -m|-i|-C|--model|--image|--cd|--add-dir|--enable|--disable|\
    --remote|--remote-auth-token-env|--local-provider|--output-schema|\
    --color|-o|--output-last-message|--thread-source)
      i=$((i + 1))
      continue ;;
    *) continue ;;
  esac
  if [[ $arg =~ ^[[:space:]]*(approval_policy|approvals_reviewer|sandbox_mode|sandbox_permissions|default_permissions)[[:space:]]*= ]]; then
    auto_review=false
  fi
done
if $auto_review; then
  set -- --approve-for-me "$@"
fi
# Inline mode preserves terminal scrollback and leaves mouse handling to the terminal.
if $no_alt_screen; then
  set -- --no-alt-screen "$@"
fi
if $automatic_handoff; then
  exec python3 "$wrapper_dir/../scripts/codex-auto-handoff" --explicit "$real_cli" "$@"
fi
exec "$real_cli" "$@"
