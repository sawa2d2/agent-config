#!/usr/bin/env bash
set -euo pipefail

# Hand the current work to a new Bob session on a new branch: create a
# worktree with gwt-path (dotfiles), move .agent-handoff.md from this working
# tree into it, and start bob there in a new tmux window. Focus stays in the
# current pane.
#
# Bob's interactive chat takes no initial prompt argument, so the handoff
# message is typed into the pane once its input box (❯) appears.
usage() { echo 'Usage: bob-delegate <new-branch> [prompt]' >&2; exit 2; }
(($# == 1 || $# == 2)) && [[ -n $1 && $1 != -* ]] || usage
branch=$1
prompt=${2:-}

[[ -n ${TMUX:-} ]] || { echo 'bob-delegate: run it inside tmux' >&2; exit 1; }
command -v gwt-path >/dev/null || { echo 'bob-delegate: gwt-path not found' >&2; exit 127; }
note="$(git rev-parse --show-toplevel)/.agent-handoff.md"
if [[ -z $prompt ]]; then
  [[ -f $note ]] || { echo 'bob-delegate: no .agent-handoff.md here; write one or pass a prompt' >&2; exit 1; }
  prompt='Read .agent-handoff.md and continue the work it describes.'
fi

dir=$(gwt-path -b "$branch")
# Move rather than copy, so this working tree does not keep a stale note.
[[ -f $note ]] && mv -- "$note" "$dir/.agent-handoff.md"
# The user chose to skip Bob's trust dialog for worktrees made here; it would
# otherwise hide the input box and swallow the typed prompt. Write to a
# temporary file and rename, so a running bob never reads a partial file.
trusted="$HOME/.bob/trustedFolders.json"
mkdir -p -- "$(dirname -- "$trusted")"
[[ -f $trusted ]] || echo '{"version":1,"folders":{}}' > "$trusted"
jq --arg dir "$(cd -- "$dir" && pwd -P)" \
  '.folders[$dir] = "TRUST_FOLDER"' "$trusted" > "$trusted.bob-delegate.tmp"
mv -- "$trusted.bob-delegate.tmp" "$trusted"
# Event-driven completion report: workspace hooks in the new worktree record
# each finished turn (Stop) and the session's end (SessionEnd) in $status.
# Workspace settings keep this out of the user's global Bob settings, so other
# Bob sessions are unaffected; Bob reads them because the folder is trusted.
here=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
status="$dir/.bob/delegate-status.json"
if git -C "$dir" ls-files --error-unmatch .bob/settings.json >/dev/null 2>&1; then
  # Never let a worker commit delegate hooks into a repository's own settings.
  echo "bob-delegate: .bob/settings.json is tracked here; no completion report" >&2
  status=
else
  mkdir -p -- "$dir/.bob"
  hook() { printf '%q %q %q' "$here/../scripts/bob-delegate-report" "$1" "$status"; }
  jq -n --arg stop "$(hook Stop)" --arg end "$(hook SessionEnd)" \
    '{hooks: {Stop: [{hooks: [{type: "command", command: $stop}]}],
              SessionEnd: [{hooks: [{type: "command", command: $end}]}]}}' > "$dir/.bob/settings.json"
  exclude=$(git -C "$dir" rev-parse --path-format=absolute --git-path info/exclude)
  mkdir -p -- "$(dirname -- "$exclude")"
  grep -qxF /.bob/ "$exclude" 2>/dev/null || echo /.bob/ >> "$exclude"
fi
session=$(tmux display-message -p -t "${TMUX_PANE:-}" '#{session_id}')
pane=$(tmux new-window -d -t "$session" -n "$branch" -c "$dir" -P -F '#{pane_id}')
echo "bob-delegate: window for $branch (pane $pane) at $dir; checking startup"
[[ -z $status ]] || echo "bob-delegate: completion report (each turn end and session end): $status"
exec python3 "$here/../lib/delegate_startup.py" -- "$pane" bob "$prompt"
