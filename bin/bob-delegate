#!/usr/bin/env bash
set -euo pipefail

# Hand the current work to a new Bob session on a new branch: create a
# worktree with gwt-path (dotfiles), move .agent-handoff.md from this working
# tree into it, and start bob there in a new tmux window. Focus stays in the
# current pane.
#
# Bob's interactive chat takes no initial prompt argument, so the handoff
# message is typed into the pane once its input box (❯) appears.
usage() { echo 'Usage: bob-delegate <new-branch> [prompt]' >&2; exit 2; }
(($# == 1 || $# == 2)) && [[ -n $1 && $1 != -* ]] || usage
branch=$1
prompt=${2:-}

[[ -n ${TMUX:-} ]] || { echo 'bob-delegate: run it inside tmux' >&2; exit 1; }
command -v gwt-path >/dev/null || { echo 'bob-delegate: gwt-path not found' >&2; exit 127; }
note="$(git rev-parse --show-toplevel)/.agent-handoff.md"
if [[ -z $prompt ]]; then
  [[ -f $note ]] || { echo 'bob-delegate: no .agent-handoff.md here; write one or pass a prompt' >&2; exit 1; }
  prompt='Read .agent-handoff.md and continue the work it describes.'
fi

dir=$(gwt-path -b "$branch")
# Move rather than copy, so this working tree does not keep a stale note.
[[ -f $note ]] && mv -- "$note" "$dir/.agent-handoff.md"
session=$(tmux display-message -p -t "${TMUX_PANE:-}" '#{session_id}')
pane=$(tmux new-window -d -t "$session" -n "$branch" -c "$dir" -P -F '#{pane_id}')
# Bob's chat takes no initial prompt argument; type the message once the input
# box (❯) appears. Keys sent before then are lost, and starting takes a few
# seconds, so wait up to 30 seconds.
(
  for _ in {1..60}; do
    tmux capture-pane -p -t "$pane" | grep -q '❯' && break
    sleep 0.5
  done
  tmux send-keys -t "$pane" -l "$prompt"
  tmux send-keys -t "$pane" Enter
) &
# bob new = bob chat --auto-approve (the bin/bob wrapper intercepts "new").
tmux send-keys -t "$pane" -l 'bob new'
tmux send-keys -t "$pane" Enter
echo "bob-delegate: bob started in window for $branch (pane $pane) at $dir"
