#!/usr/bin/env bash
set -euo pipefail

case ${1:-} in
  '') [[ $# == 0 ]] || exit 2 ;;
  -l) [[ $# == 1 ]] || { echo 'Usage: bobt [-l]' >&2; exit 2; } ;;
  *) echo 'Usage: bobt [-l]' >&2; exit 2 ;;
esac

command -v bob >/dev/null 2>&1 || { echo 'bobt: bob is required' >&2; exit 1; }

if (( $# == 0 )); then
  exec bob chat --resume latest --yolo
fi

for cmd in jq fzf; do
  command -v "$cmd" >/dev/null 2>&1 || {
    printf 'bobt: %s is required\n' "$cmd" >&2
    exit 1
  }
done

task_id=$(
  bob --list-tasks all |
    jq -r 'select(type == "object") | [(.ID // .id // ""), (.UPDATED // .updated // .updatedAt // ""), (.TITLE // .title // "")] | map(tostring) | @tsv' |
    fzf --delimiter=$'\t' --with-nth=2,3 --header='UPDATED | TITLE' --no-sort |
    cut -f1
) || exit $?

[[ -n "$task_id" ]] || exit 0
exec bob chat --resume "$task_id" --yolo
