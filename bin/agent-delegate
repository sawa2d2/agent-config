#!/usr/bin/env bash
set -euo pipefail

# Hand the current work to a new Claude session on a new branch: create a
# worktree with gwt-path (dotfiles), move .agent-handoff.md from this working
# tree into it, and start claude there in a new tmux pane. Focus stays in the
# current pane.
usage() { echo 'Usage: agent-delegate <new-branch> [prompt]' >&2; exit 2; }
(($# == 1 || $# == 2)) && [[ -n $1 && $1 != -* ]] || usage
branch=$1
prompt=${2:-}

[[ -n ${TMUX:-} ]] || { echo 'agent-delegate: run it inside tmux' >&2; exit 1; }
command -v gwt-path >/dev/null || { echo 'agent-delegate: gwt-path not found' >&2; exit 127; }
note="$(git rev-parse --show-toplevel)/.agent-handoff.md"
if [[ -z $prompt ]]; then
  [[ -f $note ]] || { echo 'agent-delegate: no .agent-handoff.md here; write one or pass a prompt' >&2; exit 1; }
  prompt='Read .agent-handoff.md and continue the work it describes.'
fi

dir=$(gwt-path -b "$branch")
# Move rather than copy, so this working tree does not keep a stale note.
[[ -f $note ]] && mv -- "$note" "$dir/.agent-handoff.md"
pane=$(tmux split-window -d -h -t "${TMUX_PANE:-}" -c "$dir" -P -F '#{pane_id}')
# Typed into the pane's interactive shell, so claude resolves as it does for
# the user (the agent-config wrapper first in PATH); the shell reads it once
# it starts.
tmux send-keys -t "$pane" -l "claude $(printf '%q' "$prompt")"
tmux send-keys -t "$pane" Enter
echo "agent-delegate: claude started in pane $pane at $dir"
