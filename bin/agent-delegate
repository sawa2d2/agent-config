#!/usr/bin/env bash
set -euo pipefail

# Hand the current work to a new Claude session on a new branch: create a
# worktree with gwt-path (dotfiles), move .agent-handoff.md from this working
# tree into it, and start claude there in a new tmux window. Focus stays in the
# current pane. -m passes a model to claude, e.g. sonnet for routine tasks.
usage() { echo 'Usage: agent-delegate [-m|--model <model>] <new-branch> [prompt]' >&2; exit 2; }
model=
if [[ ${1:-} == -m || ${1:-} == --model ]]; then
  [[ -n ${2:-} ]] || usage
  model=$2
  shift 2
fi
(($# == 1 || $# == 2)) && [[ -n $1 && $1 != -* ]] || usage
branch=$1
prompt=${2:-}

[[ -n ${TMUX:-} ]] || { echo 'agent-delegate: run it inside tmux' >&2; exit 1; }
command -v gwt-path >/dev/null || { echo 'agent-delegate: gwt-path not found' >&2; exit 127; }
note="$(git rev-parse --show-toplevel)/.agent-handoff.md"
if [[ -z $prompt ]]; then
  [[ -f $note ]] || { echo 'agent-delegate: no .agent-handoff.md here; write one or pass a prompt' >&2; exit 1; }
  prompt='Read .agent-handoff.md and continue the work it describes.'
fi

dir=$(gwt-path -b "$branch")
# Move rather than copy, so this working tree does not keep a stale note.
[[ -f $note ]] && mv -- "$note" "$dir/.agent-handoff.md"
# The user chose to skip Claude's trust dialog for worktrees made here. Write to
# a temporary file and rename, so a running claude never reads a partial file.
config="$HOME/.claude.json"
if [[ -f $config ]]; then
  jq --arg dir "$(cd -- "$dir" && pwd -P)" \
    '.projects[$dir].hasTrustDialogAccepted = true' "$config" > "$config.agent-delegate.tmp"
  mv -- "$config.agent-delegate.tmp" "$config"
fi
session=$(tmux display-message -p -t "${TMUX_PANE:-}" '#{session_id}')
pane=$(tmux new-window -d -t "$session" -n "$branch" -c "$dir" -P -F '#{pane_id}')
# Resolve the helper relative to the installed script, including symlinks.
helper="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../lib/delegate_startup.py"
echo "agent-delegate: window for $branch (pane $pane) at $dir; checking startup"
exec python3 "$helper" -- "$pane" claude "$prompt" "$model"
