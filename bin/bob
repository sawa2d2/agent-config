#!/usr/bin/env bash
set -euo pipefail

# Resolve the original Bob CLI without recursively invoking this wrapper.
wrapper_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
original_path=$PATH
PATH=
IFS=: read -r -a entries <<< "$original_path"
for entry in "${entries[@]}"; do
  [[ -n "$entry" ]] || entry=.
  [[ "$(cd -- "$entry" 2>/dev/null && pwd -P || true)" == "$wrapper_dir" ]] && continue
  PATH="${PATH:+$PATH:}$entry"
done
export PATH
real_bob=$(command -v bob || true)
[[ -n "$real_bob" ]] || { echo 'bob: original Bob Shell executable not found' >&2; exit 127; }

# Mark this process tree as an agent: gfinish (dotfiles) then merges only after
# scripts/agent-approval-marker recorded the user's "approved" prompt here.
export AGENT_APPROVAL_DIR=${AGENT_APPROVAL_DIR:-${XDG_RUNTIME_DIR:-$HOME/.cache}/agent-approval}

# Refresh the selected theme, missing default settings and tmux status hooks.
bash "$wrapper_dir/../scripts/install-bob-theme" >/dev/null
bash "$wrapper_dir/../scripts/install-bob-settings" >/dev/null
bash "$wrapper_dir/../scripts/install-agent-hooks" >/dev/null

# Restore Bob's ordinary interactive handoff; the prefix remains compatible.
if [[ ${1:-} == auto-handoff ]]; then
  shift
fi

# Type the handoff prompt into the new chat, since Bob's chat takes no initial
# prompt. Keys sent before its input box (❯) shows are lost, and starting takes
# about five seconds, so wait for the box for up to 30 seconds.
type_prompt() {
  local _
  for _ in {1..60}; do
    tmux capture-pane -p -t "$TMUX_PANE" | grep -q '❯' && break
    sleep 0.5
  done
  tmux send-keys -t "$TMUX_PANE" -l "$1" && tmux send-keys -t "$TMUX_PANE" Enter
}

# Run an auto-approved chat. When the user leaves a task that stopped at its
# cost limit, offer to continue in a new task started by `bobtask handoff`.
chat() {
  if [[ -t 0 && -t 1 ]]; then
    exec python3 "$wrapper_dir/../scripts/agent-auto-handoff" bob "$real_bob" chat --auto-approve "$@"
  fi
  local since prompt='' status answer
  while :; do
    since=$(( $(date +%s) * 1000 ))
    if [[ -n $prompt && -n ${TMUX:-} ]]; then
      # Clear the screen so the input box of the chat that just ended does not count.
      printf '\033[H\033[2J'
      type_prompt "$prompt" &
    fi
    status=0
    "$real_bob" chat --auto-approve "$@" || status=$?
    set --
    prompt=$("$wrapper_dir/bobtask" handoff --cost-limit-since "$since" --no-start) || return "$status"
    read -r -p 'bob: the task reached its cost limit. Continue in a new task? [Y/n] ' answer || answer=n
    [[ $answer == [nN]* ]] && return "$status"
  done
}

if (( $# == 0 )); then
  chat --resume latest
  exit
fi
# "new" starts a new auto-approved chat; Bob has no such subcommand.
if [[ $1 == new ]]; then
  chat "${@:2}"
  exit
fi
interactive=true
for arg in "$@"; do
  case "$arg" in --help|-h|--version|-v) interactive=false ;; esac
done
if $interactive && [[ -t 0 && -t 1 ]]; then
  case "${1:-}" in
    chat|-r|--resume|-p|--prompt)
      exec python3 "$wrapper_dir/../scripts/agent-auto-handoff" bob "$real_bob" "$@" ;;
  esac
fi
exec "$real_bob" "$@"
