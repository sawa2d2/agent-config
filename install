#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
source_dir="$repo_dir/deploy/rules"

for target in "$HOME/.bob/rules" "$HOME/.claude/rules"; do
  mkdir -p -- "$target"
  for source in "$source_dir"/*.md; do
    [[ -f "$source" ]] || continue
    dest="$target/${source##*/}"
    if [[ -L "$dest" ]]; then
      printf 'Refusing to overwrite symlink: %s\n' "$dest" >&2
      exit 1
    fi
    cp -- "$source" "$dest"
    printf 'Installed: %s\n' "$dest"
  done
done

# Install shared global instructions without overwriting unmanaged files.
for dest in "$HOME/.bob/AGENTS.md" "$HOME/.claude/CLAUDE.md" "$HOME/.codex/AGENTS.md"; do
  mkdir -p -- "${dest%/*}"
  if [[ -L "$dest" ]]; then
    printf 'Skipping existing symlink (not managed): %s\n' "$dest" >&2
    continue
  fi
  if [[ -e "$dest" ]] && ! cmp -s -- "$repo_dir/deploy/AGENTS.md" "$dest"; then
    printf 'Refusing to overwrite existing global instructions: %s\n' "$dest" >&2
    exit 1
  fi
  cp -- "$repo_dir/deploy/AGENTS.md" "$dest"
  printf 'Installed: %s\n' "$dest"
done

bash "$repo_dir/scripts/install-tools"
bash "$repo_dir/scripts/install-nix-tools"

# Install the Bob task picker as an executable command.
mkdir -p -- "$HOME/.local/bin"
for name in bobt bobta; do
  install -m 755 "$repo_dir/bin/$name" "$HOME/.local/bin/$name"
  printf 'Installed: %s\n' "$HOME/.local/bin/$name"
done
