#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
source_dir="$repo_dir/deploy/rules"

for target in "$HOME/.bob/rules" "$HOME/.claude/rules"; do
  mkdir -p -- "$target"
  for source in "$source_dir"/*.md; do
    [[ -f "$source" ]] || continue
    dest="$target/${source##*/}"
    if [[ -L "$dest" ]]; then
      printf 'Refusing to overwrite symlink: %s\n' "$dest" >&2
      exit 1
    fi
    cp -- "$source" "$dest"
    printf 'Installed: %s\n' "$dest"
  done
done

# Link shared global instructions so repository updates take effect immediately.
# Bob Shell reliably loads global instructions from ~/.bob/rules/.
for dest in "$HOME/.bob/rules/agent-config.md" "$HOME/.claude/CLAUDE.md" "$HOME/.codex/AGENTS.md"; do
  source="$repo_dir/deploy/AGENTS.md"
  mkdir -p -- "${dest%/*}"
  if [[ -L "$dest" ]]; then
    if [[ "$(readlink "$dest")" == "$source" ]]; then
      printf 'SKIP: %s\n' "$dest"
      continue
    fi
    printf 'Refusing to replace existing symlink: %s\n' "$dest" >&2
    exit 1
  fi
  if [[ -e "$dest" ]]; then
    [[ -f "$dest" ]] || { printf 'Refusing to replace non-file: %s\n' "$dest" >&2; exit 1; }
    rm -- "$dest"
  fi
  ln -s -- "$source" "$dest"
  printf 'Linked: %s -> %s\n' "$dest" "$source"
done

# Preserve legacy Bob AGENTS.md; it may contain user-managed instructions.
if [[ -e "$HOME/.bob/AGENTS.md" || -L "$HOME/.bob/AGENTS.md" ]]; then
  printf 'NOTICE: legacy ~/.bob/AGENTS.md remains in place; review it manually.\n' >&2
fi

# Claude message contrast follows the saved dotfiles theme, if present.
# The palette is embedded, so agent-config remains independently installable.
if command -v python3 >/dev/null 2>&1; then
  bash "$repo_dir/scripts/install-claude-theme"
else
  echo 'WARNING: Claude theme skipped (python3 is required)' >&2
fi

bash "$repo_dir/scripts/install-tools"
bash "$repo_dir/scripts/install-nix-tools"
