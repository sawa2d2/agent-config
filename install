#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# The engineering guidelines once copied to the agents' rules directories as
# karpathy.md are now part of deploy/AGENTS.md; remove the stale copies.
for stale in "$HOME/.bob/rules/karpathy.md" "$HOME/.claude/rules/karpathy.md"; do
  if [[ -f "$stale" && ! -L "$stale" ]]; then
    rm -- "$stale"
    printf 'Removed: %s\n' "$stale"
  fi
done

# Skills authored in this repository; install-tools adds upstream skills.
for source in "$repo_dir/deploy/skills"/*/; do
  [[ -f "$source/SKILL.md" ]] || continue
  source=${source%/}
  bash "$repo_dir/scripts/install-skill" "$source" "${source##*/}"
done

# Operational references live outside auto-loaded instruction/skill directories.
# Their fixed HOME path works from any repository, including linked worktrees.
dest="$HOME/.local/share/agent-config/operations"
source="$repo_dir/deploy/operations"
[[ -d "$source" ]] || { printf 'Missing operational references: %s\n' "$source" >&2; exit 1; }
mkdir -p -- "${dest%/*}"
if [[ -L "$dest" ]]; then
  [[ "$(readlink "$dest")" == "$source" ]] || {
    printf 'Refusing to replace existing symlink: %s\n' "$dest" >&2; exit 1;
  }
elif [[ -e "$dest" ]]; then
  printf 'Refusing to replace existing path: %s\n' "$dest" >&2
  exit 1
else
  ln -s -- "$source" "$dest"
fi

# Link shared/agent-specific globals and Codex rules for immediate repository updates.
# Bob Shell reliably loads global instructions from ~/.bob/rules/.
# Codex loads every *.rules file in ~/.codex/rules/.
for link in "$HOME/.bob/rules/agent-config.md:AGENTS.md" "$HOME/.claude/CLAUDE.md:AGENTS.md" \
  "$HOME/.codex/AGENTS.md:codex/AGENTS.md" "$HOME/.codex/rules/agent-config.rules:codex/rules/agent-config.rules"; do
  dest=${link%%:*}
  source="$repo_dir/deploy/${link#*:}"
  mkdir -p -- "${dest%/*}"
  if [[ -L "$dest" ]]; then
    if [[ "$(readlink "$dest")" == "$source" ]]; then
      printf 'SKIP: %s\n' "$dest"
      continue
    fi
    # Migrate only this installer's former shared Codex instruction link.
    if [[ "$dest" == "$HOME/.codex/AGENTS.md" && "$(readlink "$dest")" == "$repo_dir/deploy/AGENTS.md" ]]; then
      rm -- "$dest"
    else
      printf 'Refusing to replace existing symlink: %s\n' "$dest" >&2
      exit 1
    fi
  fi
  if [[ -e "$dest" ]]; then
    [[ -f "$dest" ]] || { printf 'Refusing to replace non-file: %s\n' "$dest" >&2; exit 1; }
    rm -- "$dest"
  fi
  ln -s -- "$source" "$dest"
  printf 'Linked: %s -> %s\n' "$dest" "$source"
done

# Agent utilities need PATH entries in non-interactive shells, which
# lack the aliases from shell/aliases.sh.
for bin_name in agent-delegate bob-delegate codex-delegate codex-ralph agent-backlog; do
  dest="$HOME/.local/bin/$bin_name"
  source="$repo_dir/bin/$bin_name"
  mkdir -p -- "${dest%/*}"
  if [[ -e "$dest" && ! -L "$dest" ]]; then
    printf 'Refusing to replace non-symlink: %s\n' "$dest" >&2
    exit 1
  fi
  ln -sfn -- "$source" "$dest"
  printf 'Linked: %s -> %s\n' "$dest" "$source"
done

# Preserve legacy Bob AGENTS.md; it may contain user-managed instructions.
if [[ -e "$HOME/.bob/AGENTS.md" || -L "$HOME/.bob/AGENTS.md" ]]; then
  printf 'NOTICE: legacy ~/.bob/AGENTS.md remains in place; review it manually.\n' >&2
fi

# Before install-agent-hooks, which registers the rtk hooks only while rtk is on PATH.
bash "$repo_dir/scripts/install-rtk"

# Claude, Bob and Codex colors follow the saved dotfiles theme, if present.
# The palette is embedded, so agent-config remains independently installable.
if command -v python3 >/dev/null 2>&1; then
  bash "$repo_dir/scripts/install-claude-settings"
  bash "$repo_dir/scripts/install-bob-theme"
  bash "$repo_dir/scripts/install-codex-theme"
  bash "$repo_dir/scripts/install-codex-compaction"
  bash "$repo_dir/scripts/install-codex-subagent-model"
  bash "$repo_dir/scripts/install-bob-settings"
  bash "$repo_dir/scripts/install-agent-hooks"
else
  echo 'WARNING: Claude, Bob and Codex themes, settings and hooks skipped (python3 is required)' >&2
fi

bash "$repo_dir/scripts/install-tools"
bash "$repo_dir/scripts/install-nix-tools"
# After install-nix-tools, which may provide the claude CLI on a new machine.
bash "$repo_dir/scripts/install-claude-plugins"
